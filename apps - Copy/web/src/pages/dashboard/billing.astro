---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Subscription" appShell={true}>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Subscription</h1>
      <p class="mt-1 text-sm text-slate-600">Manage your dLogicAI subscription and plan entitlements.</p>
    </div>
    <a href="/pricing" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">View plans</a>
  </div>

  <div id="subscription" class="mt-8">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">Loading subscription…</div>
  </div>

  <div class="mt-8">
    <h2 class="text-lg font-bold text-slate-950">Available plans</h2>
    <div id="plans" class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4"></div>
  </div>

  <p id="message" class="mt-6 min-h-5 text-sm" role="status"></p>

  <script is:inline>

const PLAN_ORDER = {
  plan_free: 0,
  plan_developer: 1,
  plan_pro: 2,
  plan_business: 3,
};

function getPlanAction(planId, currentPlanId) {
  if (planId === currentPlanId) {
    return { type: "current", label: "Current plan" };
  }

  const currentRank = PLAN_ORDER[currentPlanId] ?? 0;
  const targetRank = PLAN_ORDER[planId] ?? 0;

  if (targetRank > currentRank) {
    return { type: "upgrade", label: "Change to this plan" };
  }

  return { type: "downgrade", label: "Downgrade unavailable" };
}


    const subscriptionEl = document.querySelector("#subscription");
    const plansEl = document.querySelector("#plans");
    const messageEl = document.querySelector("#message");

    let currentPlanId = null;

    const money = (cents) =>
      Number(cents || 0) === 0
        ? "$0"
        : `$${(Number(cents) / 100).toFixed(0)}/month`;

    async function api(path, options = {}) {
      const response = await fetch(`/api${path}`, {
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        ...options,
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        const error = new Error(data?.error?.message || "Request failed.");
        error.status = response.status;
        error.data = data;
        throw error;
      }

      return data;
    }

    function showMessage(text, error = false) {
      messageEl.textContent = text;
      messageEl.className = `mt-6 min-h-5 text-sm ${error ? "text-red-600" : "text-emerald-600"}`;
    }

    async function load() {
      try {
        const [subscriptionData, plansData] = await Promise.all([
          api("/billing/subscription"),
          api("/plans"),
        ]);

        const s = subscriptionData.subscription;
        currentPlanId = s.plan_id;

        subscriptionEl.innerHTML = `
          <div class="grid gap-6 lg:grid-cols-[1fr_auto]">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <p class="text-sm font-medium text-slate-500">Current plan</p>
                  <h2 class="mt-1 text-2xl font-bold text-slate-950">${s.plan_name}</h2>
                </div>
                <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">${s.status}</span>
              </div>

              <div class="mt-6 grid gap-4 sm:grid-cols-3">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Monthly price</p>
                  <p class="mt-1 font-semibold text-slate-900">${money(s.monthly_price_cents)}</p>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Requests</p>
                  <p class="mt-1 font-semibold text-slate-900">${Number(s.included_requests || 0).toLocaleString()}</p>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Projects</p>
                  <p class="mt-1 font-semibold text-slate-900">${s.max_projects ?? "—"}</p>
                </div>
              </div>

              <div class="mt-6 rounded-lg bg-slate-50 p-4 text-sm text-slate-600">
                Current period:
                <strong class="text-slate-900">${new Date(Number(s.current_period_start)).toLocaleDateString()}</strong>
                →
                <strong class="text-slate-900">${new Date(Number(s.current_period_end)).toLocaleDateString()}</strong>
              </div>
            </div>

            <div class="flex items-start">
              <button id="cancel" class="rounded-lg border border-red-200 bg-white px-4 py-2.5 text-sm font-semibold text-red-700 hover:bg-red-50">
                ${s.cancel_at_period_end ? "Cancellation scheduled" : "Cancel at period end"}
              </button>
            </div>
          </div>
        `;

        document.querySelector("#cancel")?.addEventListener("click", cancelSubscription);

        plansEl.innerHTML = (plansData.plans || []).map((plan) => `
          <article class="rounded-2xl border ${plan.id === currentPlanId ? "border-blue-300 ring-2 ring-blue-50" : "border-slate-200"} bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-bold text-slate-950">${plan.name}</h3>
              ${plan.id === currentPlanId ? '<span class="rounded-full bg-blue-50 px-2 py-1 text-[11px] font-semibold text-blue-700">Current</span>' : ""}
            </div>
            <p class="mt-2 text-2xl font-extrabold text-slate-950">${money(plan.monthly_price_cents)}</p>
            <p class="mt-3 text-sm text-slate-500">${Number(plan.included_requests || 0).toLocaleString()} requests · ${plan.max_projects} projects · ${plan.max_api_keys} API keys</p>
            <button
              data-plan="${plan.id}"
              ${plan.id === currentPlanId ? "disabled" : ""}
              class="mt-5 w-full rounded-lg ${plan.id === currentPlanId ? "bg-slate-100 text-slate-400" : "bg-blue-600 text-white hover:bg-blue-700"} px-4 py-2.5 text-sm font-semibold"
            >
              ${plan.id === currentPlanId ? "Current plan" : "Change to this plan"}
            </button>
          </article>
        `).join("");

        plansEl.querySelectorAll("[data-plan]").forEach((button) => {
          button.addEventListener("click", () => changePlan(button.dataset.plan));
        });
      } catch (err) {
        if (err?.status === 401) {
          location.href = "/login";
          return;
        }
        subscriptionEl.innerHTML = `<div class="rounded-2xl border border-red-200 bg-red-50 p-6 text-sm text-red-700">${err.message}</div>`;
      }
    }

    async function changePlan(planId) {
      if (!planId || !confirm("Change the subscription to this plan?")) return;

      try {
        const data = await api("/billing/subscription/change", {
          method: "POST",
          body: JSON.stringify({ plan_id: planId }),
        });

        if (data.checkout_required) {
          showMessage("Payment checkout is required for this paid plan. The payment endpoint must be enabled before activation.", true);
          return;
        }

        showMessage("Subscription updated.");
        await load();
      } catch (err) {
        showMessage(err.message, true);
      }
    }

    async function cancelSubscription() {
      if (!confirm("Schedule this subscription for cancellation at the end of the current period?")) return;

      try {
        await api("/billing/subscription/cancel", {
          method: "POST",
          body: "{}",
        });
        showMessage("Subscription cancellation has been scheduled.");
        await load();
      } catch (err) {
        showMessage(err.message, true);
      }
    }

    load();
  </script>
</AppLayout>
