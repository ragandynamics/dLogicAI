        `INSERT INTO knowledge_base_chunks (id, tenant_id, project_id, knowledge_base_id, document_id, chunk_index, content, content_length, created_at)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)`
      ).bind(
