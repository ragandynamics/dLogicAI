    "SELECT delete_processed_sources FROM tenant_knowledge_policies WHERE tenant_id = ?"
  ).bind(tenantId).first();
  if (policy?.delete_processed_sources) {
    try {
      await c.env.DATA_BUCKET.delete(document.storage_key);
