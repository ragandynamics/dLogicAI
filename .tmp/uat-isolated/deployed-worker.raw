    `
    SELECT
      tenant_id,
      project_id
    FROM api_keys
    WHERE key_hash = ?
      AND status = 'active'
    LIMIT 1
    `
  ).bind(hash2).first();
  if (!row) {
    return null;
  }
  if (!row.tenant_id || !row.project_id) {
    console.error("API key missing tenant/project");
    return null;
  }
  c.set("apiProjectId", row.project_id);
  c.set("apiKey", raw2);
  c.executionCtx.waitUntil(
    c.env.DB.prepare(
      `
      UPDATE api_keys
      SET last_used_at = ?
      WHERE key_hash = ?
      `
    ).bind(now(), hash2).run()
  );
  return {
    userId: "api",
    tenantId: row.tenant_id,
    role: "api"
  };
}
