      WHERE tenant_id = ?
        AND created_at >= ?
        AND status IN (
          'reserved',
          'completed'
        )
    ) < ?
    `
  ).bind(
    id("use"),
    requestId,
    auth.tenantId,
    projectId,
    provider,
    model,
    billingMode,
    inputLanguage,
    outputLanguage,
    now(),
    auth.tenantId,
    periodStart,
    includedRequests
  ).run();
  return Number(result.meta?.changes || 0) === 1;
}
