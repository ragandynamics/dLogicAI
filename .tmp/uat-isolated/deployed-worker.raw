  "/v1/projects/:projectId/knowledge-bases/:knowledgeBaseId/documents/:documentId",
  async (c) => {
    const auth = await requireDashboard(c);
    if (!auth) return jsonError(c, "UNAUTHORIZED", "Authentication required.", 401);
