{
  "placement": {},
  "compatibility_date": "2026-08-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "usage_model": "standard",
  "tags": [
    "cf:service=dlogicai-api",
    "cf:environment=uat"
  ],
  "tail_consumers": [],
  "logpush": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "annotations": {
    "workers/triggered_by": "version_upload"
  },
  "bindings": [
    {
      "name": "APP_BASE_URL",
      "type": "secret_text"
    },
    {
      "name": "APP_ENV",
      "text": "uat",
      "type": "plain_text"
    },
    {
      "name": "APP_ORIGINS",
      "text": "https://dlogicai-web-uat.rdproducts-adm1.workers.dev,http://localhost:4321,http://127.0.0.1:4321",
      "type": "plain_text"
    },
    {
      "bucket_name": "dlogicai-uat-backups",
      "name": "BACKUP_BUCKET",
      "type": "r2_bucket"
    },
    {
      "name": "BYOK_STRIPE_COUPON_ID",
      "type": "secret_text"
    },
    {
      "name": "CHANNEL_QUEUE",
      "queue_name": "dlogicai-channel-work-uat",
      "type": "queue"
    },
    {
      "name": "CORS_ORIGINS",
      "text": "https://dlogicai-web-uat.rdproducts-adm1.workers.dev,http://localhost:4321,http://127.0.0.1:4321",
      "type": "plain_text"
    },
    {
      "bucket_name": "dlogicai-uat-data",
