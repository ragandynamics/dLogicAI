---
const { title = "dLogicAI" } = Astro.props;
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>{title}</title>
  <style>
    :root{font-family:Inter,system-ui,sans-serif;color:#172033;background:#f7f8fb}
    body{margin:0} a{color:inherit;text-decoration:none}
    .shell{display:flex;min-height:100vh}.side{width:220px;background:#111827;color:#fff;padding:24px}
    .brand{font-weight:800;font-size:20px;margin-bottom:28px}.nav a{display:block;padding:10px 12px;border-radius:8px;color:#cbd5e1;margin:4px 0}.nav a:hover{background:#1f2937;color:#fff}
    main{flex:1;padding:40px;max-width:1100px}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}
    .card{background:white;border:1px solid #e5e7eb;border-radius:14px;padding:20px;box-shadow:0 1px 2px rgba(0,0,0,.03)}
    .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.muted{color:#64748b;font-size:14px}.big{font-size:28px;font-weight:800;margin-top:8px}
    button{background:#111827;color:white;border:0;border-radius:8px;padding:10px 14px;cursor:pointer}.danger{background:#b91c1c}
    input,select,textarea{width:100%;box-sizing:border-box;padding:10px;border:1px solid #d1d5db;border-radius:8px;margin-top:6px}
    label{font-size:14px;font-weight:600;display:block;margin:12px 0}.row{display:flex;gap:12px}.row>*{flex:1}
    table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:12px;border-bottom:1px solid #e5e7eb;font-size:14px}
    @media(max-width:800px){.side{display:none}.grid{grid-template-columns:1fr 1fr}main{padding:20px}}
  </style>
</head>
<body>
  <slot />
</body>
</html>
