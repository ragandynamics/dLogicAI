---
import { API_BASE_URL } from "../types/env";
import { companyName, siteTagline } from "../lib/site";
import "../styles/global.css";

interface Props {
  title?: string;
  appShell?: boolean;
}

const { title = companyName, appShell = false } = Astro.props;
const pathname = Astro.url.pathname;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || "";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
const turnstileEnabled = import.meta.env.PUBLIC_TURNSTILE_ENABLED === "true";

const navGroups = [
  {
    label: "Workspace",
    items: [
      { href: "/dashboard/getting-started", label: "Getting Started" },
      { href: "/dashboard", label: "Overview" },
      { href: "/dashboard/conversations", label: "Conversations" },
      { href: "/dashboard/dialog-flows", label: "Dialog Flows" },
      { href: "/dashboard/services", label: "Chat Services" },
      { href: "/dashboard/knowledge-bases", label: "Knowledge Bases" },
      { href: "/dashboard/channel-installations", label: "Channel Installations" },
      { href: "/dashboard/usage", label: "Usage & Intelligence" },
    ],
  },
  {
    label: "Projects",
    items: [
      { href: "/dashboard/projects", label: "Projects" },
      { href: "/dashboard/playground", label: "API Playground" },
      { href: "/dashboard/api-keys", label: "API Keys" },
      { href: "/dashboard/providers", label: "AI Providers" },
    ],
  },
  {
    label: "Billing",
    items: [
      { href: "/dashboard/billing", label: "Subscription" },
      { href: "/dashboard/credits", label: "AI Credits" },
    ],
  },
  {
    label: "Administration",
    items: [
      { href: "/dashboard/team", label: "Team" },
      { href: "/dashboard/settings", label: "Settings" },
      { href: "/dashboard/data-governance", label: "Data Governance" },
      { href: "/dashboard/integrations", label: "Integrations" },
      { href: "/dashboard/service-requests", label: "Service Requests" },
      { href: "/dashboard/embed", label: "Web Embed" },
    ],
  },
];

const isActive = (href: string) =>
  pathname === href ||
  (href !== "/dashboard" && pathname.startsWith(`${href}/`));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101828" />
    <title>{title} · {companyName}</title>
  </head>

  <body>
    {appShell ? (
      <div class="min-h-screen bg-slate-50 lg:grid lg:grid-cols-[250px_minmax(0,1fr)]">
        <aside class="hidden min-h-screen bg-dlogic-navy text-white lg:block">
          <div class="sticky top-0 flex min-h-screen flex-col px-4 py-6">
            <a href="/dashboard" class="mb-8 flex items-center gap-3 px-3">
              <img src="/favicon.ico" alt="{companyName} logo" class="h-8 w-8 rounded-md object-cover" />
              <div>
                <div class="text-2xl font-extrabold tracking-tight">{companyName}</div>
                <div class="mt-1 text-[11px] leading-4 text-slate-400">
                  {siteTagline}
                </div>
              </div>
            </a>

            <nav class="space-y-6" aria-label="Main navigation">
              {navGroups.map((group) => (
                <div>
                  <div class="px-3 pb-2 text-[10px] font-bold uppercase tracking-[0.16em] text-slate-500">
                    {group.label}
                  </div>

                  <div class="space-y-1">
                    {group.items.map((item) => (
                      item.href === "/dashboard/projects" ? (
                        <div>
                          <a
                            href={item.href}
                            class:list={[
                              "block rounded-lg px-3 py-2.5 text-sm font-medium transition",
                              isActive(item.href)
                                ? "bg-white/10 text-white"
                                : "text-slate-300 hover:bg-white/5 hover:text-white",
                            ]}
                            aria-current={
                              isActive(item.href) ? "page" : undefined
                            }
                          >
                            {item.label}
                          </a>
                          <div id="desktop-project-list" class="ml-3 mt-1 space-y-1 border-l border-white/10 pl-3"></div>
                          <a href="/dashboard/projects?create=1" class="ml-3 mt-2 block text-xs font-semibold text-blue-300 hover:text-white">+ Create new project</a>
                        </div>
                      ) : (
                        <a
                          href={item.href}
                          class:list={[
                            "block rounded-lg px-3 py-2.5 text-sm font-medium transition",
                            isActive(item.href)
                              ? "bg-white/10 text-white"
                              : "text-slate-300 hover:bg-white/5 hover:text-white",
                          ]}
                          aria-current={
                            isActive(item.href) ? "page" : undefined
                          }
                        >
                          {item.label}
                        </a>
                      )
                    ))}
                  </div>
                </div>
              ))}
            </nav>

            <div class="mt-auto space-y-2 border-t border-white/10 pt-4">
              <button
                id="logout"
                class="w-full rounded-lg px-3 py-2 text-left text-sm text-slate-400 hover:bg-white/5 hover:text-white"
              >
                Sign out
              </button>
              <a
                href="/"
                class="block rounded-lg px-3 py-2 text-sm text-slate-400 hover:bg-white/5 hover:text-white"
              >
                Back to home
              </a>
            </div>
          </div>
        </aside>

        <div class="min-w-0">
          <header class="hidden items-center justify-end gap-4 border-b border-slate-200 bg-white/95 px-6 py-3 backdrop-blur lg:flex">
            <div id="desktop-project-breadcrumb" class="mr-auto flex min-w-0 items-center gap-2 text-sm text-slate-500"></div>
            <label class="flex items-center gap-2 text-xs font-semibold text-slate-500" for="desktop-environment">
              Environment
              <select id="desktop-environment" class="max-w-[260px] rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-800">
                <option>Loading…</option>
              </select>
            </label>
            <div class="h-8 w-px bg-slate-200"></div>
            <div class="relative">
              <button id="profile-toggle" type="button" aria-expanded="false" aria-controls="profile-menu" class="flex items-center gap-3 rounded-lg px-2 py-1.5 text-left hover:bg-slate-50">
                <div class="max-w-[220px]"><p id="top-user-name" class="truncate text-sm font-semibold text-slate-900">Loading user…</p><p id="top-user-reference" class="truncate text-xs text-slate-500"></p></div>
                <div class="flex h-9 w-9 items-center justify-center rounded-full bg-blue-100 text-sm font-bold text-blue-700" id="top-user-initials">U</div>
              </button>
              <div id="profile-menu" class="absolute right-0 top-12 z-30 hidden w-72 rounded-xl border border-slate-200 bg-white p-4 text-left shadow-xl">
                <p class="text-xs font-bold uppercase tracking-wide text-slate-400">Profile</p>
                <p id="profile-name" class="mt-3 truncate text-sm font-semibold text-slate-900"></p>
                <p id="profile-email" class="mt-1 truncate text-xs text-slate-500"></p>
                <div class="mt-4 border-t border-slate-100 pt-3 text-xs"><p class="text-slate-500">Workspace</p><p id="profile-workspace" class="mt-1 font-semibold text-slate-800"></p><p class="mt-3 text-slate-500">Role and privileges</p><p id="profile-privileges" class="mt-1 leading-5 text-slate-700"></p></div>
                <button id="profile-logout" type="button" class="mt-4 w-full rounded-lg border border-red-200 px-3 py-2 text-left text-sm font-semibold text-red-700 hover:bg-red-50">Sign out</button>
              </div>
            </div>
          </header>

          <header class="sticky top-0 z-20 border-b border-slate-200 bg-white/95 backdrop-blur lg:hidden">
            <div class="flex items-center justify-between gap-4 px-4 py-3">
              <a href="/dashboard" class="min-w-0 flex items-center gap-2">
                <img src="/favicon.ico" alt="{companyName} logo" class="h-6 w-6 rounded-md object-cover" />
                <div>
                  <div class="text-xl font-extrabold tracking-tight text-slate-900">{companyName}</div>
                  <div class="mt-0.5 max-w-[240px] text-[10px] leading-4 text-slate-500">
                    {siteTagline}
                  </div>
                </div>
              </a>

              <button
                id="mobile-logout"
                class="text-sm font-medium text-slate-600 hover:text-slate-900"
              >
                Sign out
              </button>
            </div>

            <div class="border-t border-slate-100 px-4 py-2">
              <button id="mobile-profile-toggle" type="button" aria-expanded="false" aria-controls="mobile-profile-menu" class="flex w-full items-center justify-between rounded-lg px-2 py-2 text-left hover:bg-slate-50">
                <span><span id="mobile-user-name" class="text-xs font-semibold text-slate-800">Loading user…</span><span id="mobile-user-role" class="ml-2 text-xs capitalize text-slate-500"></span><span id="mobile-tenant-name" class="mt-1 block truncate text-[11px] text-slate-500"></span></span><span class="text-xs text-slate-400">Profile</span>
              </button>
              <div id="mobile-profile-menu" class="hidden rounded-lg border border-slate-200 bg-white p-3 text-xs shadow-sm"><p class="font-semibold text-slate-800">Privileges</p><p id="mobile-profile-privileges" class="mt-1 leading-5 text-slate-600"></p><button id="mobile-profile-logout" type="button" class="mt-3 font-semibold text-red-700">Sign out</button></div>
              <label class="mt-2 flex items-center gap-2 text-[11px] font-semibold text-slate-500" for="mobile-environment">Environment<select id="mobile-environment" class="min-w-0 flex-1 rounded-md border border-slate-300 bg-white px-2 py-1 text-xs font-medium text-slate-800"><option>Loading…</option></select></label>
              <div id="mobile-project-breadcrumb" class="mt-2 flex min-w-0 items-center gap-2 text-xs text-slate-500"></div>
            </div>

            <nav
              class="flex gap-1 overflow-x-auto border-t border-slate-100 px-3 py-2"
              aria-label="Mobile navigation"
            >
              {navGroups.flatMap((group) => group.items).map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    "shrink-0 rounded-lg px-3 py-2 text-xs font-medium",
                    isActive(item.href)
                      ? "bg-blue-50 text-blue-700"
                      : "text-slate-600 hover:bg-slate-50",
                  ]}
                >
                  {item.label}
                </a>
              ))}
            </nav>
          </header>

          <main class="min-w-0 w-full px-4 py-6 sm:px-6 sm:py-8 lg:px-8 xl:px-10">
            <div class="mx-auto w-full max-w-[1500px]">
              <slot />
            </div>
          </main>
        </div>
      </div>
    ) : (
      <>
        <main class="min-h-screen w-full"><slot /></main>
        <footer id="contact" class="border-t border-slate-200 bg-slate-950 text-white">
          <div class="mx-auto grid w-full max-w-7xl gap-10 px-4 py-12 sm:px-6 lg:grid-cols-[1fr_1.2fr] lg:px-8">
            <div>
              <div class="flex items-center gap-3">
                <img src="/favicon.ico" alt="{companyName} logo" class="h-8 w-8 rounded-md object-cover" />
                <div>
                  <div class="text-xl font-extrabold tracking-tight">{companyName}</div>
                  <div class="mt-1 text-xs leading-5 text-slate-400">{siteTagline}</div>
                </div>
              </div>
              <p class="mt-6 max-w-sm text-sm leading-6 text-slate-400">Business conversations for sales, service, payments, billing, booking and customer support.</p>
              <p class="mt-8 text-xs text-slate-500">© {new Date().getFullYear()} {companyName}. All rights reserved.</p>
            </div>
            <div class="flex justify-start lg:justify-end">
              <button id="contact-toggle" type="button" aria-expanded="false" aria-controls="public-contact" class="inline-flex items-center gap-3 rounded-full border border-white/10 bg-white/10 px-5 py-3 text-sm font-semibold text-white shadow-lg transition hover:bg-white/15">
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-blue-500" aria-hidden="true">
                  <svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M7 18.5 3.5 21l1.2-4.5A8.5 8.5 0 0 1 3 11.5C3 6.8 7 3 12 3s9 3.8 9 8.5-4 8.5-9 8.5c-1.8 0-3.5-.5-5-1.5Z" /></svg>
                </span>
                <span>Talk to our team</span>
              </button>
              <div id="contact-panel" class="hidden w-full rounded-2xl border border-white/10 bg-white/5 p-6">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h2 class="text-lg font-bold">Talk to our team</h2>
                    <p class="mt-1 text-sm text-slate-400">Send your question and we will get back to you.</p>
                  </div>
                  <button id="contact-close" type="button" class="rounded-lg px-2 py-1 text-sm text-slate-400 hover:bg-white/10 hover:text-white">Close</button>
                </div>
              <form id="public-contact" class="mt-5 grid gap-3 sm:grid-cols-2" hidden>
                <input name="name" required minlength="2" maxlength="120" placeholder="Name" class="rounded-lg border border-white/10 bg-white/10 px-3 py-2.5 text-sm text-white placeholder:text-slate-400" />
                <input name="company_name" maxlength="160" placeholder="Company name" class="rounded-lg border border-white/10 bg-white/10 px-3 py-2.5 text-sm text-white placeholder:text-slate-400" />
                <input name="country_code" list="country-code-list" required placeholder="Country code" class="rounded-lg border border-white/10 bg-slate-900 px-3 py-2.5 text-sm text-white placeholder:text-slate-400" />
                <input name="mobile" required pattern="^[0-9][0-9]{6,14}$" placeholder="Mobile number" class="rounded-lg border border-white/10 bg-white/10 px-3 py-2.5 text-sm text-white placeholder:text-slate-400" />
                <input name="country" list="country-list" required maxlength="100" placeholder="Country" class="rounded-lg border border-white/10 bg-white/10 px-3 py-2.5 text-sm text-white placeholder:text-slate-400 sm:col-span-2" />
                <input name="email" required type="email" maxlength="255" placeholder="Email address" class="rounded-lg border border-white/10 bg-white/10 px-3 py-2.5 text-sm text-white placeholder:text-slate-400 sm:col-span-2" />
                <select name="enquiry_type" required class="rounded-lg border border-white/10 bg-slate-900 px-3 py-2.5 text-sm text-white sm:col-span-2"><option value="">Enquiry type</option><option value="sales">Sales and pricing</option><option value="product">Product information</option><option value="support">Technical support</option><option value="partnership">Partnership</option><option value="other">Other</option></select>
                <textarea name="query" required minlength="3" maxlength="5000" rows="4" placeholder="How can we help?" class="rounded-lg border border-white/10 bg-white/10 px-3 py-2.5 text-sm text-white placeholder:text-slate-400 sm:col-span-2"></textarea>
                {turnstileEnabled && turnstileSiteKey && <div class="sm:col-span-2" data-turnstile-sitekey={turnstileSiteKey} id="turnstile-widget"></div>}
                <button class="rounded-lg bg-blue-500 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-400 sm:col-span-2">Send message</button>
                <p id="public-contact-message" class="min-h-5 text-sm text-slate-300 sm:col-span-2" role="status"></p>
                <datalist id="country-code-list">
