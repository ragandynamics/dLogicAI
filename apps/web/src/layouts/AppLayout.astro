  {gaMeasurementId && (
    <>
      <aside
        id="analytics-consent"
        class="fixed inset-x-4 bottom-4 z-50 hidden max-w-xl rounded-xl border border-slate-200 bg-white p-4 shadow-xl sm:left-6 sm:right-auto"
        aria-label="Analytics consent"
      >
        <p class="text-sm leading-6 text-slate-700">
          Allow anonymous usage analytics to help us improve dLogicAI?
        </p>
        <div class="mt-3 flex gap-2">
          <button
            id="analytics-accept"
            class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700"
          >
            Allow analytics
          </button>
          <button
            id="analytics-reject"
            class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
          >
            Decline
          </button>
        </div>
      </aside>

      <script is:inline define:vars={{ gaMeasurementId }}>
        const analyticsConsentKey = "dlogicai_analytics_consent";
        const analyticsBanner = document.querySelector("#analytics-consent");

        function loadAnalytics() {
          if (window.__dlogicaiAnalyticsLoaded || !gaMeasurementId) return;
          window.__dlogicaiAnalyticsLoaded = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag("js", new Date());
          window.gtag("config", gaMeasurementId, { anonymize_ip: true });
          const script = document.createElement("script");
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaMeasurementId)}`;
          document.head.appendChild(script);
        }

        const consent = window.localStorage.getItem(analyticsConsentKey);
        if (consent === "accepted") loadAnalytics();
        if (!consent) analyticsBanner?.classList.remove("hidden");

        document.querySelector("#analytics-accept")?.addEventListener("click", () => {
          window.localStorage.setItem(analyticsConsentKey, "accepted");
          analyticsBanner?.remove();
          loadAnalytics();
        });

        document.querySelector("#analytics-reject")?.addEventListener("click", () => {
          window.localStorage.setItem(analyticsConsentKey, "rejected");
          analyticsBanner?.remove();
        });
      </script>
    </>
  )}

  {appShell && (
    <script is:inline define:vars={{ apiBaseUrl: API_BASE_URL }}>
      async function loadCurrentUser() {
        try {
          const [response, projectsResponse] = await Promise.all([
            fetch(`${apiBaseUrl}/v1/me`, { credentials: "include" }),
            fetch(`${apiBaseUrl}/v1/projects`, { credentials: "include" }),
          ]);
          if (response.status === 401 || projectsResponse.status === 401) {
            window.location.href = "/login";
            return;
          }
          if (!response.ok || !projectsResponse.ok) return;

          const data = await response.json();
          const projectData = await projectsResponse.json();
          const user = data.user || {};
          const tenant = data.tenant || {};
          const role = data.role || "member";
          const projects = role === "member"
            ? (projectData.projects || []).filter((project) => project.environment !== "production")
            : (projectData.projects || []);
          const priority = { development: 0, staging: 1, production: 2 };
          const routeProjectId = new URLSearchParams(window.location.search).get("projectId") || window.location.pathname.match(/\/projects\/([^/]+)/)?.[1];
          const storedProjectId = window.sessionStorage.getItem("dlogicai_active_project");
          const activeProject = projects.find((project) => project.id === routeProjectId)
            || projects.find((project) => project.id === storedProjectId)
            || [...projects].sort((a, b) => (priority[a.environment] ?? 99) - (priority[b.environment] ?? 99))[0];
          const currentEnvironment = activeProject?.environment;
          const projectList = document.querySelector("#desktop-project-list");
          if (projectList) {
            const environmentProjects = projects.filter((project) => project.environment === currentEnvironment);
            projectList.replaceChildren(...environmentProjects.map((project) => {
              const link = document.createElement("a");
              link.href = `/dashboard/projects/${encodeURIComponent(project.id)}`;
              link.textContent = `${project.name} · ${project.environment}`;
              link.className = `block truncate rounded px-2 py-1 text-xs ${activeProject?.id === project.id ? "bg-white/10 text-white" : "text-slate-400 hover:bg-white/5 hover:text-slate-200"}`;
              return link;
            }));
          }
          const breadcrumb = activeProject
            ? `<span class="font-semibold text-slate-800">Projects</span><span aria-hidden="true">/</span><span class="truncate font-semibold text-slate-900">${activeProject.name}</span><span aria-hidden="true">/</span><span class="rounded-full bg-blue-50 px-2 py-1 text-xs font-semibold capitalize text-blue-700">${activeProject.environment}</span>`
            : `<span class="font-semibold text-slate-800">Projects</span>`;
          document.querySelector("#desktop-project-breadcrumb").innerHTML = breadcrumb;
          document.querySelector("#mobile-project-breadcrumb").innerHTML = breadcrumb;
          document.querySelector("#mobile-user-name").textContent = user.name || user.email || "User";
          document.querySelector("#mobile-user-role").textContent = role;
          document.querySelector("#mobile-tenant-name").textContent = tenant.name || "Workspace";
          document.querySelector("#top-user-name").textContent = user.name || user.email || "User";
          document.querySelector("#top-user-reference").textContent = `${user.email || ""} · ${role}`;
          document.querySelector("#top-user-initials").textContent = (user.name || user.email || "U").split(/\s+/).map((part) => part[0]).join("").slice(0, 2).toUpperCase();
          document.querySelector("#profile-name").textContent = user.name || user.email || "User";
          document.querySelector("#profile-email").textContent = user.email || "";
          document.querySelector("#profile-workspace").textContent = tenant.name || "Workspace";
          document.querySelector("#profile-privileges").textContent = role === "owner" || role === "admin" ? `${role}: manage members, billing, secrets, environments, services, and logs.` : "member: manage development/staging environments, services, knowledge, conversations, and logs.";
          document.querySelector("#mobile-profile-privileges").textContent = role === "owner" || role === "admin" ? `${role}: full workspace administration.` : "member: development/staging environments, services, knowledge, conversations, and logs.";
          const environments = [...new Set(projects.map((project) => project.environment))].sort((a, b) => (priority[a] ?? 99) - (priority[b] ?? 99));
          const environmentOptions = document.querySelectorAll("#desktop-environment, #mobile-environment");
          environmentOptions.forEach((select) => {
            select.replaceChildren(...environments.map((environment) => { const option = document.createElement("option"); option.value = environment; option.textContent = environment; return option; }));
            if (activeProject) select.value = activeProject.environment;
            select.addEventListener("change", () => {
              const selectedProject = projects.find((project) => project.environment === select.value);
              if (!selectedProject) return;
              window.sessionStorage.setItem("dlogicai_active_project", selectedProject.id);
              window.location.href = `/dashboard/projects/${encodeURIComponent(selectedProject.id)}`;
            });
          });
        } catch {
          document.querySelector("#mobile-user-name").textContent = "User";
        }
      }

      async function logout() {
        await fetch(`${apiBaseUrl}/v1/auth/logout`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: "{}",
        });
        window.location.href = "/login";
      }

      document
        .querySelector("#logout")
        ?.addEventListener("click", logout);

      document
        .querySelector("#mobile-logout")
        ?.addEventListener("click", logout);

      function toggleProfileMenu(toggleId, menuId) {
        const toggle = document.querySelector(toggleId);
        const menu = document.querySelector(menuId);
        toggle?.addEventListener("click", () => {
          const open = menu.classList.toggle("hidden");
          toggle.setAttribute("aria-expanded", String(!open));
        });
      }

      document.querySelector("#profile-logout")?.addEventListener("click", logout);
      document.querySelector("#mobile-profile-logout")?.addEventListener("click", logout);
      toggleProfileMenu("#profile-toggle", "#profile-menu");
      toggleProfileMenu("#mobile-profile-toggle", "#mobile-profile-menu");

      loadCurrentUser();
    </script>
  )}

  {!appShell && (
    <script is:inline define:vars={{ apiBaseUrl: API_BASE_URL, visitorCountryCode: Astro.request.headers.get("cf-ipcountry")?.toUpperCase() || "" }}>
      function getDefaultCountryName(preferredCountryCode) {
        const regionCode = preferredCountryCode || ((navigator.languages && navigator.languages[0]) || navigator.language || "en-US").split("-").pop()?.toUpperCase();

        if (!regionCode || !/^[A-Z]{2}$/.test(regionCode)) {
          return "";
        }

        try {
          return new Intl.DisplayNames(["en"], { type: "region" }).of(regionCode) || "";
        } catch {
          return "";
        }
      }

      function getDefaultCountryCode(countryName) {
        const dialCodes = {
          "United States": "+1",
          "United Kingdom": "+44",
          "India": "+91",
          "Canada": "+1",
          "Australia": "+61",
          "Singapore": "+65",
          "United Arab Emirates": "+971",
          "Germany": "+49",
          "France": "+33",
          "Spain": "+34",
          "Italy": "+39",
          "Netherlands": "+31",
          "Belgium": "+32",
          "Switzerland": "+41",
          "Sweden": "+46",
          "Norway": "+47",
          "Denmark": "+45",
          "Finland": "+358",
          "South Africa": "+27",
          "Brazil": "+55",
          "Mexico": "+52",
          "Argentina": "+54",
          "Japan": "+81",
          "South Korea": "+82",
          "China": "+86",
          "Hong Kong": "+852",
          "Taiwan": "+886",
          "Thailand": "+66",
          "Vietnam": "+84",
          "Indonesia": "+62",
          "Malaysia": "+60",
          "Philippines": "+63",
          "Pakistan": "+92",
          "Bangladesh": "+880",
          "Sri Lanka": "+94",
          "Nigeria": "+234",
          "Kenya": "+254",
          "Egypt": "+20",
          "Saudi Arabia": "+966",
        };

        return dialCodes[countryName] || "";
      }

      const defaultCountry = getDefaultCountryName(visitorCountryCode);
      const countryField = document.querySelector("#public-contact input[name='country']");
      if (countryField && !countryField.value && defaultCountry) {
        countryField.value = defaultCountry;
      }

      const countryCodeField = document.querySelector("#public-contact input[name='country_code']");
      const defaultCountryCode = defaultCountry ? getDefaultCountryCode(defaultCountry) : "";
      if (countryCodeField && !countryCodeField.value && defaultCountryCode) {
        countryCodeField.value = defaultCountryCode;
      }

      const contactForm = document.querySelector("#public-contact");
      const contactMessage = document.querySelector("#public-contact-message");
      const contactToggle = document.querySelector("#contact-toggle");
      const contactClose = document.querySelector("#contact-close");
      const contactPanel = document.querySelector("#contact-panel");
      function setContactOpen(isOpen) {
        contactPanel?.classList.toggle("hidden", !isOpen);
        contactForm.hidden = !isOpen;
        contactToggle.hidden = isOpen;
        contactToggle.setAttribute("aria-expanded", String(isOpen));
        if (isOpen) contactPanel?.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
      contactToggle?.addEventListener("click", () => setContactOpen(true));
      contactClose?.addEventListener("click", () => setContactOpen(false));
      const turnstileSiteKey = document.querySelector("#turnstile-widget")?.dataset.sitekey || "";
      let turnstileToken = "";
      if (turnstileSiteKey) {
        const script = document.createElement("script");
        script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
        script.onload = () => window.turnstile?.render("#turnstile-widget", { sitekey: turnstileSiteKey, callback: (token) => { turnstileToken = token; } });
        document.head.appendChild(script);
      }
      contactForm?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const form = new FormData(event.currentTarget);
        const response = await fetch(`${apiBaseUrl}/v1/public/contact`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ name: form.get("name"), company_name: form.get("company_name"), country_code: form.get("country_code"), country: form.get("country"), mobile: form.get("mobile"), email: form.get("email"), enquiry_type: form.get("enquiry_type"), query: form.get("query"), turnstile_token: turnstileToken }) });
        const data = await response.json().catch(() => ({}));
        contactMessage.textContent = response.ok ? "Thanks. Your message has been received." : data?.error?.message || "Unable to send your message.";
        contactMessage.className = `min-h-5 text-sm sm:col-span-2 ${response.ok ? "text-emerald-300" : "text-red-300"}`;
        if (response.ok) contactForm.reset();
      });
    </script>
  )}
