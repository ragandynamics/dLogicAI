---
import { API_BASE_URL } from "../types/env";
import "../styles/global.css";

interface Props {
  title?: string;
  appShell?: boolean;
}

const { title = "dLogicAI", appShell = false } = Astro.props;
const pathname = Astro.url.pathname;
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || "";

const navGroups = [
  {
    label: "Workspace",
    items: [
      { href: "/dashboard", label: "Dashboard" },
      { href: "/dashboard/services", label: "Chat Services" },
      { href: "/dashboard/conversations", label: "Conversations" },
      { href: "/dashboard/playground", label: "API Playground" },
      { href: "/dashboard/usage", label: "Usage & Intelligence" },
    ],
  },
  {
    label: "Development",
    items: [
      { href: "/dashboard/projects", label: "Projects" },
      { href: "/dashboard/providers", label: "AI Providers" },
      { href: "/dashboard/api-keys", label: "API Keys" },
    ],
  },
  {
    label: "Billing",
    items: [
      { href: "/dashboard/billing", label: "Subscription" },
      { href: "/dashboard/credits", label: "AI Credits" },
    ],
  },
  {
    label: "Administration",
    items: [
      { href: "/dashboard/team", label: "Team" },
      { href: "/dashboard/settings", label: "Settings" },
      { href: "/dashboard/data-governance", label: "Data Governance" },
      { href: "/dashboard/integrations", label: "Integrations" },
      { href: "/dashboard/embed", label: "Web Embed" },
    ],
  },
];

const isActive = (href: string) =>
  pathname === href ||
  (href !== "/dashboard" && pathname.startsWith(`${href}/`));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101828" />
    <title>{title} · dLogicAI</title>
  </head>

  <body>
    {appShell ? (
      <div class="min-h-screen bg-slate-50 lg:grid lg:grid-cols-[250px_minmax(0,1fr)]">
        <aside class="hidden min-h-screen bg-dlogic-navy text-white lg:block">
          <div class="sticky top-0 flex min-h-screen flex-col px-4 py-6">
            <a href="/dashboard" class="mb-8 px-3">
              <div class="text-2xl font-extrabold tracking-tight">dLogicAI</div>
              <div class="mt-1 text-[11px] leading-4 text-slate-400">
                AI Powered Customer Conversations
              </div>
            </a>

            <nav class="space-y-6" aria-label="Main navigation">
              {navGroups.map((group) => (
                <div>
                  <div class="px-3 pb-2 text-[10px] font-bold uppercase tracking-[0.16em] text-slate-500">
                    {group.label}
                  </div>

                  <div class="space-y-1">
                    {group.items.map((item) => (
                      <a
                        href={item.href}
                        class:list={[
                          "block rounded-lg px-3 py-2.5 text-sm font-medium transition",
                          isActive(item.href)
                            ? "bg-white/10 text-white"
                            : "text-slate-300 hover:bg-white/5 hover:text-white",
                        ]}
                        aria-current={
                          isActive(item.href) ? "page" : undefined
                        }
                      >
                        {item.label}
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </nav>

            <div class="mt-auto space-y-2 border-t border-white/10 pt-4">
              <button
                id="logout"
                class="w-full rounded-lg px-3 py-2 text-left text-sm text-slate-400 hover:bg-white/5 hover:text-white"
              >
                Sign out
              </button>
              <a
                href="/"
                class="block rounded-lg px-3 py-2 text-sm text-slate-400 hover:bg-white/5 hover:text-white"
              >
                Back to home
              </a>
            </div>
          </div>
        </aside>

        <div class="min-w-0">
          <header class="sticky top-0 z-20 border-b border-slate-200 bg-white/95 backdrop-blur lg:hidden">
            <div class="flex items-center justify-between gap-4 px-4 py-3">
              <a href="/dashboard" class="min-w-0">
                <div class="text-xl font-extrabold tracking-tight text-slate-900">dLogicAI</div>
                <div class="mt-0.5 max-w-[240px] text-[10px] leading-4 text-slate-500">
                  AI Powered Customer Conversations
                </div>
              </a>

              <button
                id="mobile-logout"
                class="text-sm font-medium text-slate-600 hover:text-slate-900"
              >
                Sign out
              </button>
            </div>

            <nav
              class="flex gap-1 overflow-x-auto border-t border-slate-100 px-3 py-2"
              aria-label="Mobile navigation"
            >
              {navGroups.flatMap((group) => group.items).map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    "shrink-0 rounded-lg px-3 py-2 text-xs font-medium",
                    isActive(item.href)
                      ? "bg-blue-50 text-blue-700"
                      : "text-slate-600 hover:bg-slate-50",
                  ]}
                >
                  {item.label}
                </a>
              ))}
            </nav>
          </header>

          <main class="min-w-0 w-full px-4 py-6 sm:px-6 sm:py-8 lg:px-8 xl:px-10">
            <div class="mx-auto w-full max-w-[1500px]">
              <slot />
            </div>
          </main>
        </div>
      </div>
    ) : (
      <main class="min-h-screen w-full">
        <slot />
      </main>
    )}
  </body>

  {gaMeasurementId && (
    <>
      <aside
        id="analytics-consent"
        class="fixed inset-x-4 bottom-4 z-50 hidden max-w-xl rounded-xl border border-slate-200 bg-white p-4 shadow-xl sm:left-6 sm:right-auto"
        aria-label="Analytics consent"
      >
        <p class="text-sm leading-6 text-slate-700">
          Allow anonymous usage analytics to help us improve dLogicAI?
        </p>
        <div class="mt-3 flex gap-2">
          <button
            id="analytics-accept"
            class="rounded-lg bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700"
          >
            Allow analytics
          </button>
          <button
            id="analytics-reject"
            class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
          >
            Decline
          </button>
        </div>
      </aside>

      <script is:inline define:vars={{ gaMeasurementId }}>
        const analyticsConsentKey = "dlogicai_analytics_consent";
        const analyticsBanner = document.querySelector("#analytics-consent");

        function loadAnalytics() {
          if (window.__dlogicaiAnalyticsLoaded || !gaMeasurementId) return;
          window.__dlogicaiAnalyticsLoaded = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag("js", new Date());
          window.gtag("config", gaMeasurementId, { anonymize_ip: true });
          const script = document.createElement("script");
          script.async = true;
          script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(gaMeasurementId)}`;
          document.head.appendChild(script);
        }

        const consent = window.localStorage.getItem(analyticsConsentKey);
        if (consent === "accepted") loadAnalytics();
        if (!consent) analyticsBanner?.classList.remove("hidden");

        document.querySelector("#analytics-accept")?.addEventListener("click", () => {
          window.localStorage.setItem(analyticsConsentKey, "accepted");
          analyticsBanner?.remove();
          loadAnalytics();
        });

        document.querySelector("#analytics-reject")?.addEventListener("click", () => {
          window.localStorage.setItem(analyticsConsentKey, "rejected");
          analyticsBanner?.remove();
        });
      </script>
    </>
  )}

  {appShell && (
    <script is:inline define:vars={{ apiBaseUrl: API_BASE_URL }}>
      async function logout() {
        await fetch(`${apiBaseUrl}/v1/auth/logout`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: "{}",
        });
        window.location.href = "/login";
      }

      document
        .querySelector("#logout")
        ?.addEventListener("click", logout);

      document
        .querySelector("#mobile-logout")
        ?.addEventListener("click", logout);
    </script>
  )}
</html>
