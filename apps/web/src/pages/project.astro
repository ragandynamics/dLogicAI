---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Project — dLogicAI">
  <div class="shell">
    <aside class="side"><div class="brand">dLogicAI</div><nav class="nav"><a href="/">Overview</a><a href="/projects">Projects</a><a href="/usage">Usage</a></nav></aside>
    <main>
      <h1>Project</h1>
      <div class="card">
        <h2>API keys</h2>
        <form id="keyForm" class="row"><div><input id="keyName" placeholder="Production" /></div><div style="max-width:140px"><button>Create key</button></div></form>
        <pre id="secret" style="white-space:pre-wrap"></pre>
        <table><thead><tr><th>Name</th><th>Prefix</th><th>Status</th><th>Last used</th></tr></thead><tbody id="keys"></tbody></table>
      </div>
      <div style="height:20px"></div>
      <div class="card">
        <h2>BYOK provider</h2>
        <form id="providerForm">
          <div class="row"><label>Provider<select id="provider"><option value="openai">OpenAI</option><option value="google">Gemini</option></select></label><label>Name<input id="providerName" value="Primary" /></label></div>
          <label>API key<input id="providerKey" type="password" required /></label>
          <button>Save encrypted provider key</button>
        </form>
        <pre id="providerResult"></pre>
      </div>
    </main>
  </div>
  <script>
    const API=import.meta.env.PUBLIC_API_URL||"http://localhost:8787";
    const pid=new URLSearchParams(location.search).get("id");
    async function api(p,o={}){const r=await fetch(API+p,{...o,credentials:"include",headers:{"Content-Type":"application/json",...(o.headers||{})}});const d=await r.json();if(!r.ok)throw new Error(d.error?.message||"Request failed");return d;}
    async function load(){const d=await api(`/v1/projects/${pid}/api-keys`);keys.innerHTML=d.api_keys.map(k=>`<tr><td>${k.name}</td><td><code>${k.key_prefix}...</code></td><td>${k.status}</td><td>${k.last_used_at?new Date(k.last_used_at).toLocaleString():"never"}</td></tr>`).join("")}
    keyForm.addEventListener("submit",async e=>{e.preventDefault();const d=await api(`/v1/projects/${pid}/api-keys`,{method:"POST",body:JSON.stringify({name:keyName.value||"API key"})});secret.textContent=`SAVE THIS NOW:\n${d.api_key.secret}`;load()});
    providerForm.addEventListener("submit",async e=>{e.preventDefault();const d=await api(`/v1/projects/${pid}/providers`,{method:"POST",body:JSON.stringify({provider:provider.value,name:providerName.value,api_key:providerKey.value})});providerResult.textContent=`Saved ${d.credential.provider} credential ${d.credential.name}. The key is encrypted and cannot be retrieved.`;providerKey.value=""});
    load();
  </script>
</Layout>
