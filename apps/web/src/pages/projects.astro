---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Projects — dLogicAI">
  <div class="shell">
    <aside class="side"><div class="brand">dLogicAI</div><nav class="nav"><a href="/">Overview</a><a href="/projects">Projects</a><a href="/playground">Playground</a><a href="/usage">Usage</a></nav></aside>
    <main>
      <h1>Projects</h1>
      <div class="card">
        <form id="newProject" class="row">
          <div><label>Project name<input id="projectName" required placeholder="Customer Support" /></label></div>
          <div><label>Environment<select id="environment"><option>production</option><option>staging</option><option>development</option></select></label></div>
          <div style="align-self:end"><button>Create</button></div>
        </form>
      </div>
      <div style="height:20px"></div>
      <div class="card"><table><thead><tr><th>Name</th><th>Environment</th><th>ID</th><th>API keys</th></tr></thead><tbody id="rows"></tbody></table></div>
    </main>
  </div>
  <script>
    const API=import.meta.env.PUBLIC_API_URL||"http://localhost:8787";
    async function api(p,o={}){const r=await fetch(API+p,{...o,credentials:"include",headers:{"Content-Type":"application/json",...(o.headers||{})}});if(!r.ok)throw new Error((await r.json()).error?.message||"Request failed");return r.json();}
    async function load(){try{const d=await api("/v1/projects");rows.innerHTML=d.projects.map(p=>`<tr><td>${p.name}</td><td>${p.environment}</td><td><code>${p.id}</code></td><td><a href="/project?id=${encodeURIComponent(p.id)}">Manage</a></td></tr>`).join("")}catch(e){location.href="/login"}}
    newProject.addEventListener("submit",async e=>{e.preventDefault();await api("/v1/projects",{method:"POST",body:JSON.stringify({name:projectName.value,environment:environment.value})});projectName.value="";load()});load();
  </script>
</Layout>
