---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="API Keys" appShell={true}>
  <div><h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">API Keys</h1><p class="mt-1 text-sm text-slate-600">Create developer keys. Secrets are shown only once.</p></div>
  <div class="mt-8 rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><div class="grid grid-cols-1 gap-4 lg:grid-cols-[1fr_1fr_auto] lg:items-end"><div><label class="text-sm font-medium text-slate-700">Project</label><select id="project" class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm"></select></div><div><label class="text-sm font-medium text-slate-700">Key name</label><input id="name" class="mt-1.5 block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm" value="Developer API Key" /></div><button id="create" class="rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">Create API key</button></div><div id="result" class="mt-5 hidden rounded-lg border border-amber-200 bg-amber-50 p-4"><div class="text-sm font-semibold text-amber-900">Store this secret now. It will not be shown again.</div><code id="secret" class="mt-2 block break-all text-sm text-amber-950"></code></div></div>
  <section class="mt-8 rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="text-lg font-bold text-slate-950">Project keys</h2><div id="keys" class="mt-4 space-y-2"></div></section>
  <script>
    import { API_BASE_URL } from "../../types/env";
    const project = document.querySelector("#project") as HTMLSelectElement; const result = document.querySelector("#result") as HTMLElement; const secret = document.querySelector("#secret") as HTMLElement; const keys = document.querySelector("#keys") as HTMLElement;
    const loadKeys = async () => { if (!project.value) return; const r = await fetch(`${API_BASE_URL}/v1/projects/${project.value}/api-keys`, { credentials: "include" }); const d = await r.json().catch(() => ({})); keys.innerHTML = (d.api_keys || []).map((key: any) => `<div class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-slate-200 p-3"><div><strong class="text-sm text-slate-900">${key.name}</strong><div class="text-xs text-slate-500">${key.key_prefix} · ${key.status}</div></div>${key.status === "active" ? `<button data-key="${key.id}" class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-700">Deactivate</button>` : ""}</div>`).join("") || `<p class="text-sm text-slate-500">No API keys for this project.</p>`; keys.querySelectorAll("[data-key]").forEach((button) => button.addEventListener("click", async () => { if (!confirm("Deactivate this API key?")) return; const keyId = (button as HTMLButtonElement).dataset.key; await fetch(`${API_BASE_URL}/v1/projects/${project.value}/api-keys/${keyId}/deactivate`, { method: "POST", credentials: "include" }); loadKeys(); })); };
    const load = async () => { const r = await fetch(`${API_BASE_URL}/v1/projects`, { credentials: "include" }); if (!r.ok) { location.href = "/login"; return; } const d = await r.json(); project.innerHTML = (d.projects || []).map((p: any) => `<option value="${p.id}">${p.name} (${p.environment})</option>`).join(""); loadKeys(); };
    project.addEventListener("change", loadKeys); document.querySelector("#create")?.addEventListener("click", async () => { if (!project.value) return; const r = await fetch(`${API_BASE_URL}/v1/projects/${project.value}/api-keys`, { method: "POST", headers: { "Content-Type": "application/json" }, credentials: "include", body: JSON.stringify({ name: (document.querySelector("#name") as HTMLInputElement).value }) }); const d = await r.json().catch(() => ({})); if (!r.ok) { alert(d.error?.message || "Unable to create key"); return; } secret.textContent = d.api_key.secret; result.classList.remove("hidden"); loadKeys(); });
    load();
  </script>
</AppLayout>
