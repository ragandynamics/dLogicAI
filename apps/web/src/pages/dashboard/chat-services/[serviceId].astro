---
import AppLayout from "../../../layouts/AppLayout.astro";
const { serviceId } = Astro.params;
---

<AppLayout title="Chat Service" appShell={true}>
  <div class="flex items-center justify-between gap-4">
    <div>
      <a href="/dashboard/services" class="text-sm font-medium text-blue-600 hover:text-blue-700">← Chat Services</a>
      <h1 id="service-name" class="mt-3 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Loading Chat Service…</h1>
      <p id="service-description" class="mt-2 text-sm text-slate-600"></p>
    </div>
    <span id="service-status" class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">Loading</span>
  </div>

  <div id="error" class="mt-6 hidden rounded-xl bg-red-50 p-4 text-sm text-red-700"></div>

  <div id="content" class="mt-8 grid gap-5 md:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="font-bold text-slate-950">Service configuration</h2>
      <dl class="mt-5 space-y-4 text-sm">
        <div class="flex justify-between gap-4"><dt class="text-slate-500">Environment</dt><dd id="environment" class="font-semibold text-slate-900"></dd></div>
        <div class="flex justify-between gap-4"><dt class="text-slate-500">Default language</dt><dd id="language" class="font-semibold text-slate-900"></dd></div>
        <div class="flex justify-between gap-4"><dt class="text-slate-500">AI provider</dt><dd id="provider" class="font-semibold text-slate-900"></dd></div>
        <div class="flex justify-between gap-4"><dt class="text-slate-500">Model</dt><dd id="model" class="font-semibold text-slate-900"></dd></div>
      </dl>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="font-bold text-slate-950">Conversation intelligence</h2>
      <div class="mt-5 space-y-3 text-sm text-slate-700">
        <div id="intelligence"></div>
        <div id="emotion"></div>
        <div id="upsell"></div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ serviceId }}>
    async function loadService() {
      const error = document.querySelector("#error");
      try {
        const response = await fetch(`/api/projects/${encodeURIComponent(new URLSearchParams(window.location.search).get("projectId") || "")}/chat-services/${encodeURIComponent(serviceId)}`, { credentials: "include" });
        if (!response.ok) {
          throw new Error("Unable to load this Chat Service. Open it from the Chat Services page so its project context is available.");
        }
        const data = await response.json();
        const service = data.chat_service;
        document.querySelector("#service-name").textContent = service.name;
        document.querySelector("#service-description").textContent = service.description || "No description provided.";
        document.querySelector("#service-status").textContent = service.status;
        document.querySelector("#environment").textContent = service.environment;
        document.querySelector("#language").textContent = service.default_language;
        document.querySelector("#provider").textContent = service.ai_provider;
        document.querySelector("#model").textContent = service.model;
        document.querySelector("#intelligence").textContent = `${service.enable_intelligence ? "✓" : "—"} Conversation intelligence`;
        document.querySelector("#emotion").textContent = `${service.enable_emotion_analysis ? "✓" : "—"} Emotion analysis`;
        document.querySelector("#upsell").textContent = `${service.enable_upsell_analysis ? "✓" : "—"} Upsell analysis`;
      } catch (e) {
        error.textContent = e.message;
        error.classList.remove("hidden");
      }
    }
    loadService();
  </script>
</AppLayout>
