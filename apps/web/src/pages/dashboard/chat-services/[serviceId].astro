---
import AppLayout from "../../../layouts/AppLayout.astro";
import { API_BASE_URL } from "../../../types/env";
const { serviceId } = Astro.params;
---

<AppLayout title="Chat Service" appShell={true}>
  <a id="interactive-forms-link" href={`/dashboard/forms?serviceId=${encodeURIComponent(serviceId || '')}`} class="text-sm text-blue-700 underline">Interactive Forms — build and review submissions</a>
  <div class="flex items-center justify-between gap-4">
    <div>
      <a href="/dashboard/services" class="text-sm font-medium text-blue-600 hover:text-blue-700">← Chat Services</a>
      <h1 id="service-name" class="mt-3 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Loading Chat Service…</h1>
      <p id="service-description" class="mt-2 text-sm text-slate-600"></p>
    </div>
    <span id="service-status" class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">Loading</span>
  </div>

  <div id="error" class="mt-6 hidden rounded-xl bg-red-50 p-4 text-sm text-red-700"></div>

  <form id="content" class="mt-8 grid gap-5 md:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="font-bold text-slate-950">Service configuration</h2>
      <div class="mt-5 space-y-4 text-sm">
        <label class="block font-medium text-slate-700">Name<input id="name" name="name" required maxlength="120" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5" /></label>
        <label class="block font-medium text-slate-700">Description<textarea id="description" name="description" maxlength="500" rows="3" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5"></textarea></label>
        <label class="block font-medium text-slate-700">Default language<input id="language" name="default_language" required maxlength="32" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5" /></label>
        <label class="block font-medium text-slate-700">LLM key <span class="font-normal text-slate-500">(optional)</span><input id="llm_key" name="llm_key" type="password" autocomplete="new-password" minlength="10" maxlength="1000" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5" placeholder="Google Gemini API key" /></label>
        <p id="provider-help" class="text-xs leading-5 text-slate-500">Leave this blank to use dLogicFlow managed Gemini. A saved key is encrypted and never displayed.</p>
        <label id="remove-key-row" class="hidden items-center gap-2 text-xs text-slate-600"><input id="remove_key" type="checkbox" class="h-4 w-4" /> Remove the saved LLM key and use managed AI</label>
        <label class="block font-medium text-slate-700">Model<input id="model" name="model" required maxlength="120" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5" /></label>
        <div class="rounded-xl border border-blue-100 bg-blue-50 p-4">
          <label class="flex items-start gap-3 font-medium text-slate-800"><input id="auto_topup" type="checkbox" class="mt-0.5 h-4 w-4" /><span>Enable managed AI credit auto top-up<span class="mt-1 block text-xs font-normal leading-5 text-slate-600">Save a 90% low-balance trigger to reduce service disruption.</span></span></label>
          <p id="auto-topup-note" class="mt-2 text-xs text-slate-500"></p>
        </div>
      </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <h2 class="font-bold text-slate-950">Conversation intelligence</h2>
      <div class="mt-5 space-y-3 text-sm text-slate-700">
        <label class="flex items-center gap-3"><input id="intelligence" name="enable_intelligence" type="checkbox" class="h-4 w-4" /> Conversation intelligence</label>
        <label class="flex items-center gap-3"><input id="emotion" name="enable_emotion_analysis" type="checkbox" class="h-4 w-4" /> Emotion analysis</label>
        <label class="flex items-center gap-3"><input id="upsell" name="enable_upsell_analysis" type="checkbox" class="h-4 w-4" /> Upsell analysis</label>
      </div>
      <div class="mt-6 flex flex-wrap gap-3"><button type="submit" class="rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">Save changes</button><a id="channels-link" href="/dashboard/channels" class="rounded-lg border border-slate-300 px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Configure channels</a><button id="delete-service" type="button" class="rounded-lg border border-red-200 px-4 py-2.5 text-sm font-semibold text-red-700 hover:bg-red-50">Delete</button></div>
      <p id="save-message" class="mt-3 min-h-5 text-sm" role="status"></p>
    </div>
  </form>

  <div class="mt-8 rounded-xl border border-blue-100 bg-blue-50 p-5">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div><p class="text-xs font-bold uppercase tracking-wide text-blue-700">Guided conversations</p><h2 class="mt-1 font-bold text-slate-950">Design the conversation flow visually</h2><p class="mt-1 text-sm text-slate-600">Arrange states, connect transitions, and define expected outcomes on a dedicated workspace.</p></div>
      <a id="flow-designer-link" href={`/dashboard/dialog-flows/${encodeURIComponent(serviceId || "")}`} class="shrink-0 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">Open flow designer</a>
    </div>
  </div>

  <script is:inline define:vars={{ serviceId, apiBaseUrl: API_BASE_URL }}>
    let hasSavedLlmKey = false;
    document.querySelector('#interactive-forms-link').href += '&projectId=' + encodeURIComponent(new URLSearchParams(location.search).get('projectId') || '');

    async function loadService() {
      const error = document.querySelector("#error");
      try {
        const response = await fetch(`${apiBaseUrl}/v1/projects/${encodeURIComponent(new URLSearchParams(window.location.search).get("projectId") || "")}/chat-services/${encodeURIComponent(serviceId)}`, { credentials: "include" });
        if (!response.ok) {
          throw new Error("Unable to load this Chat Service. Open it from the Chat Services page so its project context is available.");
        }
        const data = await response.json();
        const service = data.chat_service;
        hasSavedLlmKey = Boolean(service.llm_key_configured);
        document.querySelector("#service-name").textContent = service.name;
        document.querySelector("#service-description").textContent = service.description || "No description provided.";
        document.querySelector("#service-status").textContent = service.status;
        document.querySelector("#name").value = service.name;
        document.querySelector("#description").value = service.description || "";
        document.querySelector("#language").value = service.default_language;
        document.querySelector("#model").value = service.model;
        document.querySelector("#intelligence").checked = Boolean(service.enable_intelligence);
        document.querySelector("#emotion").checked = Boolean(service.enable_emotion_analysis);
        document.querySelector("#upsell").checked = Boolean(service.enable_upsell_analysis);
        document.querySelector("#channels-link").href = `/dashboard/channels?projectId=${encodeURIComponent(new URLSearchParams(window.location.search).get("projectId") || "")}&serviceId=${encodeURIComponent(service.id)}`;
        document.querySelector("#flow-designer-link").href = `/dashboard/dialog-flows/${encodeURIComponent(service.id)}?projectId=${encodeURIComponent(new URLSearchParams(window.location.search).get("projectId") || "")}`;
        const removeRow = document.querySelector("#remove-key-row");
        removeRow.classList.toggle("hidden", !hasSavedLlmKey);
        removeRow.classList.toggle("flex", hasSavedLlmKey);
        document.querySelector("#provider-help").textContent = hasSavedLlmKey
          ? "A service LLM key is configured. Leave this field blank to keep it, or select Remove to use managed Gemini."
          : "Leave this blank to use dLogicFlow managed Gemini. A saved key is encrypted and never displayed.";
        await loadAutoTopup();
      } catch (e) {
        error.textContent = e.message;
        error.classList.remove("hidden");
      }
    }
    async function loadAutoTopup() {
      const response = await fetch(`${apiBaseUrl}/v1/billing/credits`, { credentials: "include" });
      const data = await response.json().catch(() => ({}));
      document.querySelector("#auto_topup").checked = Boolean(data.credits?.auto_topup?.enabled);
      updateAutoTopupState();
    }
    function updateAutoTopupState() {
      const customKeyWillRemain = (hasSavedLlmKey && !document.querySelector("#remove_key").checked) || Boolean(document.querySelector("#llm_key").value.trim());
      const toggle = document.querySelector("#auto_topup");
      toggle.disabled = customKeyWillRemain;
      document.querySelector("#auto-topup-note").textContent = customKeyWillRemain
        ? "Auto top-up applies only when managed AI is used."
        : "Automatic charging also requires the managed credit-pack billing workflow, which is not active yet.";
    }
    document.querySelector("#llm_key")?.addEventListener("input", updateAutoTopupState);
    document.querySelector("#remove_key")?.addEventListener("change", updateAutoTopupState);
    document.querySelector("#content")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const serviceForm = event.currentTarget;
      const form = new FormData(serviceForm);
      const projectId = new URLSearchParams(window.location.search).get("projectId") || "";
      const enteredKey = String(form.get("llm_key") || "").trim();
      const removeKey = document.querySelector("#remove_key").checked;
      const payload = { name: form.get("name"), description: form.get("description"), default_language: form.get("default_language"), ai_provider: "google", model: form.get("model"), provider_mode: "managed", provider_credential_id: null, enable_intelligence: form.get("enable_intelligence") === "on", enable_emotion_analysis: form.get("enable_emotion_analysis") === "on", enable_upsell_analysis: form.get("enable_upsell_analysis") === "on" };
      if (enteredKey) payload.llm_key = enteredKey;
      else if (removeKey) payload.llm_key = null;
      const response = await fetch(`${apiBaseUrl}/v1/projects/${encodeURIComponent(projectId)}/chat-services/${encodeURIComponent(serviceId)}`, { method: "PATCH", credentials: "include", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
      const message = document.querySelector("#save-message");
      const data = await response.json().catch(() => ({}));
      let saved = response.ok;
      if (saved && !((hasSavedLlmKey && !removeKey) || enteredKey)) {
        const topupResponse = await fetch(`${apiBaseUrl}/v1/billing/credits/auto-topup`, { method: "PATCH", credentials: "include", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ enabled: document.querySelector("#auto_topup").checked }) });
        saved = topupResponse.ok;
      }
      message.textContent = saved ? "Changes saved." : data?.error?.message || "Unable to save changes.";
      message.className = `mt-3 min-h-5 text-sm ${saved ? "text-emerald-600" : "text-red-600"}`;
      if (saved) loadService();
    });
    document.querySelector("#delete-service")?.addEventListener("click", async () => {
      if (!window.confirm("Delete this Chat Service?")) return;
      const projectId = new URLSearchParams(window.location.search).get("projectId") || "";
      const response = await fetch(`${apiBaseUrl}/v1/projects/${encodeURIComponent(projectId)}/chat-services/${encodeURIComponent(serviceId)}`, { method: "DELETE", credentials: "include" });
      if (response.ok) window.location.href = "/dashboard/services";
    });
    loadService();
  </script>
</AppLayout>
