---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Conversations" appShell={true}>
  <div><h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Conversations</h1><p class="mt-1 text-sm text-slate-600">Review customer interactions and outcomes.</p></div>
  <div class="mt-8 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm"><div class="overflow-x-auto"><table class="min-w-[700px] w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-5 py-3 font-semibold">Title</th><th class="px-5 py-3 font-semibold">Model</th><th class="px-5 py-3 font-semibold">Language</th><th class="px-5 py-3 font-semibold">Updated</th></tr></thead><tbody id="rows" class="divide-y divide-slate-100"></tbody></table></div></div>
  <script>
    import { API_BASE_URL } from "../../types/env";fetch(`${API_BASE_URL}/v1/conversations`).then(async r => { if (!r.ok) { location.href = "/login"; return; } const d = await r.json(); document.querySelector("#rows")!.innerHTML = (d.conversations || []).map((x: any) => `<tr class="hover:bg-slate-50"><td class="px-5 py-3 font-medium text-slate-900">${x.title || "Untitled"}</td><td class="px-5 py-3 text-slate-600">${x.model}</td><td class="px-5 py-3 text-slate-600">${x.language}</td><td class="px-5 py-3 text-slate-600">${new Date(x.updated_at).toLocaleString()}</td></tr>`).join(""); });</script>
</AppLayout>
