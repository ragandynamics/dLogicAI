---
import AppLayout from "../../layouts/AppLayout.astro";
import { API_BASE_URL } from "../../types/env";
---

<AppLayout title="Conversations" appShell={true}>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between"><div><h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Customer conversations</h1><p class="mt-1 text-sm text-slate-600">Monitor enquiries, live message exchanges, and customer tone from one workspace.</p></div><span id="live-status" class="text-xs font-semibold text-emerald-600">Live updates on</span></div>

  <section class="mt-8 rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><div class="flex items-center justify-between gap-4"><div><h2 class="font-bold text-slate-950">Channels</h2><p class="mt-1 text-xs text-slate-500">Where customer enquiries arrive.</p></div><a href="/dashboard/channels" class="text-sm font-semibold text-blue-600 hover:text-blue-700">Manage channels</a></div><div id="channels" class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6"></div></section>

  <section class="mt-6 grid min-h-[620px] gap-5 xl:grid-cols-[300px_minmax(0,1fr)]"><aside class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm"><div class="border-b border-slate-100 px-4 py-4"><div class="flex items-center justify-between"><h2 class="font-bold text-slate-950">Customer enquiries</h2><span id="conversation-count" class="rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600">0</span></div><input id="search" class="mt-3 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" placeholder="Search enquiries" /></div><div id="conversation-list" class="max-h-[540px] overflow-y-auto"></div></aside><main class="min-w-0 rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5"><div class="flex flex-wrap items-center justify-between gap-3"><div><h2 class="font-bold text-slate-950">Message windows</h2><p class="mt-1 text-xs text-slate-500">Open multiple enquiries side by side for comparison.</p></div><button id="clear-windows" type="button" class="rounded-lg border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50">Clear windows</button></div><div id="windows" class="mt-5 grid gap-4 md:grid-cols-2 2xl:grid-cols-3"><div class="rounded-xl border border-dashed border-slate-300 p-8 text-center text-sm text-slate-500 md:col-span-2 2xl:col-span-3">Select an enquiry to open its message window.</div></div></main></section>

  <script is:inline define:vars={{ apiBaseUrl: API_BASE_URL }}>
    const channelData = [["Web Chat", "Available", "blue"], ["WhatsApp", "Coming soon", "emerald"], ["Messenger", "Coming soon", "indigo"], ["Instagram", "Coming soon", "pink"], ["Telegram", "Coming soon", "sky"], ["TikTok", "Planned", "slate"]];
    const channels = document.querySelector("#channels");
    const list = document.querySelector("#conversation-list");
    const windows = document.querySelector("#windows");
    const search = document.querySelector("#search");
    const openWindows = new Set();
    let conversations = [];
    const escapeHtml = (value) => String(value ?? "").replace(/[&<>\"']/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#039;" }[character]));
    channels.innerHTML = channelData.map(([name, status]) => `<div class="rounded-lg border border-slate-200 p-3"><div class="flex items-center gap-2"><span class="h-2 w-2 rounded-full ${status === "Available" ? "bg-emerald-500" : "bg-slate-300"}"></span><span class="text-sm font-semibold text-slate-800">${name}</span></div><p class="mt-1 text-xs text-slate-500">${status}</p></div>`).join("");
    function toneLabel(item) { return item.sentiment || item.emotion || "Pending analysis"; }
    function renderList() {
      const query = search.value.trim().toLowerCase();
      const visible = conversations.filter((item) => `${item.title || ""} ${item.project_name || ""} ${toneLabel(item)}`.toLowerCase().includes(query));
      document.querySelector("#conversation-count").textContent = String(conversations.length);
      list.innerHTML = visible.length ? visible.map((item) => `<button type="button" data-conversation="${escapeHtml(item.id)}" class="block w-full border-b border-slate-100 px-4 py-4 text-left hover:bg-slate-50 ${openWindows.has(item.id) ? "bg-blue-50" : ""}"><div class="flex items-start justify-between gap-2"><span class="truncate text-sm font-semibold text-slate-900">${escapeHtml(item.title || "Untitled enquiry")}</span><span class="shrink-0 text-[11px] text-slate-400">${new Date(item.updated_at).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}</span></div><p class="mt-1 truncate text-xs text-slate-500">${escapeHtml(item.project_name || "Project")} · ${escapeHtml(item.language || "auto")}</p><div class="mt-2 flex gap-2 text-[11px]"><span class="rounded-full bg-slate-100 px-2 py-1 text-slate-600">${escapeHtml(toneLabel(item))}</span>${Number(item.urgency_score || 0) > 60 ? '<span class="rounded-full bg-amber-50 px-2 py-1 text-amber-700">Urgent</span>' : ""}</div></button>`).join("") : `<p class="p-5 text-sm text-slate-500">No customer enquiries yet.</p>`;
      list.querySelectorAll("[data-conversation]").forEach((button) => button.addEventListener("click", () => { openWindows.add(button.dataset.conversation); renderList(); renderWindows(); }));
    }
    async function loadConversation(id) { const response = await fetch(`${apiBaseUrl}/v1/conversations/${encodeURIComponent(id)}`, { credentials: "include" }); return response.ok ? response.json() : null; }
    async function renderWindows() {
      if (!openWindows.size) { windows.innerHTML = `<div class="rounded-xl border border-dashed border-slate-300 p-8 text-center text-sm text-slate-500 md:col-span-2 2xl:col-span-3">Select an enquiry to open its message window.</div>`; return; }
      const details = (await Promise.all([...openWindows].map(loadConversation))).filter(Boolean);
      windows.innerHTML = details.map((data) => { const item = data.conversation; const insight = data.intelligence; const paused = Boolean(item.auto_response_paused); return `<article class="flex min-h-[520px] min-w-0 flex-col overflow-hidden rounded-xl border border-slate-200 bg-slate-50"><header class="border-b border-slate-200 bg-white p-4"><div class="flex items-start justify-between gap-3"><div class="min-w-0"><h3 class="truncate text-sm font-bold text-slate-950">${escapeHtml(item.title || "Untitled enquiry")}</h3><p class="mt-1 truncate text-xs text-slate-500">${escapeHtml(item.project_id)} · ${escapeHtml(item.model || "auto")}</p></div><button type="button" data-close="${escapeHtml(item.id)}" class="text-xs font-semibold text-slate-400 hover:text-slate-700">Close</button></div><div class="mt-3 grid grid-cols-2 gap-2 text-xs"><div class="rounded-lg bg-slate-100 p-2"><span class="block text-slate-500">Sentiment</span><strong class="text-slate-900">${escapeHtml(insight?.sentiment || "Pending")}</strong></div><div class="rounded-lg bg-slate-100 p-2"><span class="block text-slate-500">Tone</span><strong class="text-slate-900">${escapeHtml(insight?.emotion || "Pending")}</strong></div></div>${insight ? `<p class="mt-2 text-xs text-slate-600">${escapeHtml(insight.next_best_action || insight.business_event || "Analysis available")}</p>` : ""}<button type="button" data-pause="${escapeHtml(item.id)}" data-paused="${paused}" class="mt-3 rounded-lg border px-3 py-2 text-xs font-semibold ${paused ? "border-emerald-200 text-emerald-700" : "border-amber-200 text-amber-700"}">${paused ? "Resume auto responses" : "Pause auto responses"}</button></header><div class="flex-1 space-y-3 overflow-y-auto p-4">${(data.messages || []).map((message) => `<div class="${message.role === "user" ? "mr-5" : "ml-5"}"><div class="rounded-xl ${message.role === "user" ? "bg-white" : "bg-blue-600 text-white"} p-3 text-sm leading-6 shadow-sm">${escapeHtml(message.content)}</div><p class="mt-1 text-[10px] text-slate-400">${escapeHtml(message.role)} · ${new Date(message.created_at).toLocaleTimeString()}</p></div>`).join("") || '<p class="text-sm text-slate-500">No messages yet.</p>'}</div><form data-reply="${escapeHtml(item.id)}" class="border-t border-slate-200 bg-white p-3"><div class="flex gap-2"><input name="content" required maxlength="10000" placeholder="Send a direct message" class="min-w-0 flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm" /><button class="rounded-lg bg-blue-600 px-3 py-2 text-xs font-semibold text-white hover:bg-blue-700">Send</button></div></form></article>`; }).join("");
      windows.querySelectorAll("[data-close]").forEach((button) => button.addEventListener("click", () => { openWindows.delete(button.dataset.close); renderList(); renderWindows(); }));
      windows.querySelectorAll("[data-pause]").forEach((button) => button.addEventListener("click", async () => { const paused = button.dataset.paused !== "true"; await fetch(`${apiBaseUrl}/v1/conversations/${encodeURIComponent(button.dataset.pause)}/auto-response`, { method: "PATCH", credentials: "include", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ paused }) }); await renderWindows(); }));
      windows.querySelectorAll("[data-reply]").forEach((form) => form.addEventListener("submit", async (event) => { event.preventDefault(); const replyForm = event.currentTarget; const formData = new FormData(replyForm); const response = await fetch(`${apiBaseUrl}/v1/conversations/${encodeURIComponent(replyForm.dataset.reply)}/messages`, { method: "POST", credentials: "include", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ content: formData.get("content") }) }); if (response.ok) { replyForm.reset(); await renderWindows(); } }));
    }
    async function load() { const response = await fetch(`${apiBaseUrl}/v1/conversations`, { credentials: "include" }); if (!response.ok) { window.location.href = "/login"; return; } const data = await response.json(); conversations = data.conversations || []; renderList(); await renderWindows(); }
    search.addEventListener("input", renderList); document.querySelector("#clear-windows").addEventListener("click", () => { openWindows.clear(); renderList(); renderWindows(); }); load(); window.setInterval(load, 5000);
  </script>
</AppLayout>
