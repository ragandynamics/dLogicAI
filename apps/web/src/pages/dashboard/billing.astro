---
import AppLayout from "../../layouts/AppLayout.astro";
import { API_BASE_URL } from "../../types/env";
---

<AppLayout title="Subscription" appShell={true}>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Subscription</h1>
      <p class="mt-1 text-sm text-slate-600">Manage your dLogicAI subscription and plan entitlements.</p>
    </div>
    <a href="/pricing" class="rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">View plans</a>
  </div>

  <div id="subscription" class="mt-8">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">Loading subscription…</div>
  </div>

  <div class="mt-8">
    <h2 class="text-lg font-bold text-slate-950">Available plans</h2>
    <div id="plans" class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4"></div>
  </div>

  <p id="message" class="mt-6 min-h-5 text-sm" role="status"></p>

  <script is:inline define:vars={{ apiBaseUrl: API_BASE_URL }}>
    const subscriptionEl = document.querySelector("#subscription");
    const plansEl = document.querySelector("#plans");
    const messageEl = document.querySelector("#message");

    let currentPlanId = null;

    const money = (cents) =>
      Number(cents || 0) === 0
        ? "$0"
        : `$${(Number(cents) / 100).toFixed(0)}/month`;

      const limit = (value, suffix = "") => Number(value || 0) > 0 ? `${Number(value).toLocaleString()}${suffix}` : "Not included";
      const byokFee = (micros) => `$${(Number(micros || 0) / 1000000).toFixed(5)}/request`;

    async function api(path, options = {}) {
      const response = await fetch(`${apiBaseUrl}/v1${path}`, {
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        ...options,
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        const error = new Error(data?.error?.message || "Request failed.");
        error.status = response.status;
        error.data = data;
        throw error;
      }

      return data;
    }

    function showMessage(text, error = false) {
      messageEl.textContent = text;
      messageEl.className = `mt-6 min-h-5 text-sm ${error ? "text-red-600" : "text-emerald-600"}`;
    }

    async function load() {
      try {
        const [subscriptionData, plansData] = await Promise.all([
          api("/billing/subscription"),
          api("/billing/catalog"),
        ]);

        const s = subscriptionData.subscription;
        currentPlanId = s.plan_id;
        const currentPlanPrice = Number(s.monthly_price_cents || 0);
        const pendingPlanId = s.pending_plan_id;

        subscriptionEl.innerHTML = `
          <div class="grid gap-6 lg:grid-cols-[1fr_auto]">
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
              <div class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <p class="text-sm font-medium text-slate-500">Current plan</p>
                  <h2 class="mt-1 text-2xl font-bold text-slate-950">${s.plan_name}</h2>
                </div>
                <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">${s.status}</span>
              </div>

              <div class="mt-6 grid gap-4 sm:grid-cols-3">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Monthly price</p>
                  <p class="mt-1 font-semibold text-slate-900">${money(s.monthly_price_cents)}</p>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Requests</p>
                  <p class="mt-1 font-semibold text-slate-900">${Number(s.included_requests || 0).toLocaleString()}</p>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">Projects</p>
                  <p class="mt-1 font-semibold text-slate-900">${s.max_projects ?? "—"}</p>
                </div>
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">BYOK offer</p>
                  <p class="mt-1 font-semibold text-slate-900">${Number(s.byok_enabled) && Number(s.byok_monthly_price_cents) > 0 ? `${money(s.byok_monthly_price_cents)}/month fixed fee` : "Not included"}</p>
                </div>
              </div>

              <div class="mt-6 rounded-lg bg-slate-50 p-4 text-sm text-slate-600">
                Current period:
                <strong class="text-slate-900">${new Date(Number(s.current_period_start)).toLocaleDateString()}</strong>
                →
                <strong class="text-slate-900">${new Date(Number(s.current_period_end)).toLocaleDateString()}</strong>
              </div>
              ${pendingPlanId && Number(s.trial_ends_at) > 0 ? `<div class="mt-3 rounded-lg bg-amber-50 p-4 text-sm text-amber-800">${s.pending_plan_name} trial ends ${new Date(Number(s.trial_ends_at)).toLocaleDateString()}.</div>` : ""}
            </div>

            <div class="flex items-start">
              ${s.external_subscription_id
                ? '<button id="manage" class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Manage subscription</button>'
                : ''}
            </div>
          </div>
        `;

        document.querySelector("#manage")?.addEventListener("click", openPortal);

        plansEl.innerHTML = (plansData.plans || []).map((plan) => {
          const isCurrent = plan.id === currentPlanId;
          const isPending = plan.id === pendingPlanId;
          const isUpgrade = Number(plan.monthly_price_cents || 0) > currentPlanPrice;
          const isDisabled = isCurrent || isPending || !isUpgrade;
          return `
          <article class="rounded-2xl border ${isCurrent ? "border-blue-300 ring-2 ring-blue-50" : "border-slate-200"} bg-white p-5 shadow-sm">
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-bold text-slate-950">${plan.name}</h3>
              ${isCurrent ? '<span class="rounded-full bg-blue-50 px-2 py-1 text-[11px] font-semibold text-blue-700">Current</span>' : isPending ? '<span class="rounded-full bg-amber-50 px-2 py-1 text-[11px] font-semibold text-amber-700">Trial pending</span>' : ""}
            </div>
            <p class="mt-2 text-2xl font-extrabold text-slate-950">${money(plan.monthly_price_cents)}</p>
            <p class="mt-3 text-sm text-slate-500">${Number(plan.included_requests || 0).toLocaleString()} requests · ${plan.max_projects} projects · ${plan.max_api_keys} API keys</p>
            <p class="mt-3 text-sm text-slate-500">${limit(plan.max_knowledge_bases)} knowledge bases · ${limit(plan.max_documents)} documents · ${limit(Number(plan.max_storage_bytes || 0) / (1024 * 1024 * 1024), " GB")} RAG storage</p>
            <p class="mt-3 text-sm text-slate-500">${Number(plan.byok_enabled) ? `BYOK · ${money(plan.byok_monthly_price_cents)}/month · ${byokFee(plan.byok_request_fee_micros)} platform fee` : "BYOK not included"}</p>
            <button
              data-plan="${plan.id}"
              ${isDisabled ? "disabled" : ""}
              class="mt-5 w-full rounded-lg ${isDisabled ? "bg-slate-100 text-slate-400" : "bg-blue-600 text-white hover:bg-blue-700"} px-4 py-2.5 text-sm font-semibold"
            >
              ${isCurrent ? "Current plan" : isPending ? "Trial pending" : isUpgrade ? "Upgrade to this plan" : "Unavailable"}
            </button>
          </article>
        `;
        }).join("");

        plansEl.querySelectorAll("[data-plan]").forEach((button) => {
          button.addEventListener("click", () => changePlan(button.dataset.plan));
        });
      } catch (err) {
        if (err?.status === 401) {
          location.href = "/login";
          return;
        }
        subscriptionEl.innerHTML = `<div class="rounded-2xl border border-red-200 bg-red-50 p-6 text-sm text-red-700">${err.message}</div>`;
      }
    }

    async function changePlan(planId) {
      if (!planId || !confirm("Upgrade your subscription to this plan?")) return;

      try {
        const data = await api("/billing/subscription/change", {
          method: "POST",
          body: JSON.stringify({ plan_id: planId }),
        });

        if (data.portal_required) {
          await openPortal();
          return;
        }

        if (data.checkout_required) {
          await startCheckout(planId);
          return;
        }

        showMessage("Subscription updated.");
        await load();
      } catch (err) {
        showMessage(err.message, true);
      }
    }

    async function startCheckout(planId) {
      try {
        const data = await api("/billing/stripe/checkout", {
          method: "POST",
          body: JSON.stringify({
            plan_id: planId,
            trial: trialRequested && planId === "plan_developer",
            success_url: `${window.location.origin}/dashboard/billing?checkout=success&session_id={CHECKOUT_SESSION_ID}`,
            cancel_url: `${window.location.origin}/dashboard/billing?checkout=cancelled`,
          }),
        });
        window.location.assign(data.checkout_url);
      } catch (err) {
        showMessage(err.message, true);
      }
    }

    async function openPortal() {
      try {
        const data = await api("/billing/stripe/portal", {
          method: "POST",
          body: JSON.stringify({ return_url: `${window.location.origin}/dashboard/billing` }),
        });
        window.location.assign(data.url);
      } catch (err) {
        showMessage(err.message, true);
      }
    }

    const checkoutParams = new URLSearchParams(window.location.search);
    const checkoutState = checkoutParams.get("checkout");
    const checkoutSessionId = checkoutParams.get("session_id");
    const trialRequested = checkoutState === "unavailable";
    if (checkoutState === "cancelled") showMessage("Checkout was cancelled.", true);
    if (checkoutState === "unavailable") showMessage("Your account is ready. Start the Developer trial from this page when Stripe is available.", true);

    async function confirmCheckout() {
      if (checkoutState !== "success" || !checkoutSessionId) return;
      try {
        await api("/billing/stripe/checkout/confirm", {
          method: "POST",
          body: JSON.stringify({ session_id: checkoutSessionId }),
        });
        showMessage("Checkout completed. Your subscription is active.");
      } catch (err) {
        showMessage(err.message || "Checkout is complete, but subscription confirmation is still pending.", true);
      }
    }

    confirmCheckout().finally(load);
  </script>
</AppLayout>
