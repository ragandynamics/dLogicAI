---
import AppLayout from "../../layouts/AppLayout.astro";
const services = [
  ["Sales", "Product discovery, recommendations, quotations and conversion"],
  ["Customer Service", "Order tracking, returns, complaints and escalation"],
  ["Payments & Billing", "Payment status, invoices, refunds and billing questions"],
  ["Booking & Appointments", "Availability, booking, rescheduling and cancellation"],
];
---

<AppLayout title="Chat Services" appShell={true}>
  <div><h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Chat Services</h1><p class="mt-1 text-sm text-slate-600">Configure customer-facing services around business goals.</p></div>
  <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4">
    {services.map(([name, desc]) => <div class="flex flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><span class="w-fit rounded-full bg-blue-50 px-2 py-1 text-xs font-semibold text-blue-700">Business function</span><h2 class="mt-4 text-lg font-bold text-slate-950">{name}</h2><p class="mt-2 flex-1 text-sm leading-6 text-slate-600">{desc}</p><button class="mt-5 rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">Configure</button></div>)}
  </div>
</AppLayout>
