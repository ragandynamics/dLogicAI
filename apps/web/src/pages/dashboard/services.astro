---
import AppLayout from "../../layouts/AppLayout.astro";
import { API_BASE_URL } from "../../types/env";
---

<AppLayout title="Chat Services" appShell={true}>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div><h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Chat Services</h1><p class="mt-1 text-sm text-slate-600">Configure reusable customer experiences and their business functions.</p></div>
    <label class="text-sm font-medium text-slate-700">Project<select id="project" class="ml-2 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm"></select></label>
  </div>

  <div class="mt-8 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="font-bold text-slate-950">Add a business function</h2>
    <form id="create-service" class="mt-4 grid gap-4 md:grid-cols-[1fr_1.5fr_auto] md:items-end">
      <label class="text-sm font-medium text-slate-700">Name<input name="name" required maxlength="120" class="mt-1.5 block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm" placeholder="Sales" /></label>
      <label class="text-sm font-medium text-slate-700">Description<input name="description" maxlength="500" class="mt-1.5 block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm" placeholder="Product discovery, recommendations and conversion" /></label>
      <button class="rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700" type="submit">Create service</button>
    </form>
    <p id="service-message" class="mt-3 min-h-5 text-sm" role="status"></p>
  </div>

  <div id="service-list" class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-4"></div>

  <script is:inline define:vars={{ apiBaseUrl: API_BASE_URL }}>
    const projectSelect = document.querySelector("#project");
    const serviceList = document.querySelector("#service-list");
    const message = document.querySelector("#service-message");

    function showMessage(text, isError = false) {
      message.textContent = text;
      message.className = `mt-3 min-h-5 text-sm ${isError ? "text-red-600" : "text-emerald-600"}`;
    }

    function renderServices(services) {
      serviceList.innerHTML = services.length
        ? services.map((service) => `<article class="flex flex-col rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><span class="w-fit rounded-full bg-blue-50 px-2 py-1 text-xs font-semibold text-blue-700">Business function</span><h2 class="mt-4 text-lg font-bold text-slate-950">${service.name}</h2><p class="mt-2 flex-1 text-sm leading-6 text-slate-600">${service.description || "No description provided."}</p><div class="mt-5 flex items-center justify-between gap-3"><span class="text-xs text-slate-500">${service.environment} · ${service.status}</span><a href="/dashboard/chat-services/${encodeURIComponent(service.id)}?projectId=${encodeURIComponent(service.project_id)}" class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white hover:bg-blue-700">Configure</a></div></article>`).join("")
        : `<div class="rounded-xl border border-dashed border-slate-300 p-8 text-center text-sm text-slate-500 md:col-span-2 xl:col-span-4">No Chat Services yet. Create your first business function above.</div>`;
    }

    async function loadServices() {
      if (!projectSelect.value) return renderServices([]);
      const response = await fetch(`${apiBaseUrl}/v1/projects/${encodeURIComponent(projectSelect.value)}/chat-services`, { credentials: "include" });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) return showMessage(data?.error?.message || "Unable to load Chat Services.", true);
      renderServices(data.chat_services || []);
    }

    async function loadProjects() {
      const response = await fetch(`${apiBaseUrl}/v1/projects`, { credentials: "include" });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) return (window.location.href = "/login");
      projectSelect.innerHTML = (data.projects || []).map((project) => `<option value="${project.id}">${project.name} (${project.environment})</option>`).join("");
      await loadServices();
    }

    projectSelect?.addEventListener("change", loadServices);
    document.querySelector("#create-service")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const serviceForm = event.currentTarget;
      if (!projectSelect.value) return showMessage("Create a project before adding a Chat Service.", true);
      const form = new FormData(serviceForm);
      const response = await fetch(`${apiBaseUrl}/v1/projects/${encodeURIComponent(projectSelect.value)}/chat-services`, { method: "POST", credentials: "include", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ name: form.get("name"), description: form.get("description") }) });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) return showMessage(data?.error?.message || "Unable to create Chat Service.", true);
      serviceForm.reset();
      showMessage("Chat Service created.");
      await loadServices();
    });

    loadProjects();
  </script>
</AppLayout>
