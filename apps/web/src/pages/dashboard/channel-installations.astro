---
import AppLayout from "../../layouts/AppLayout.astro";
import { API_BASE_URL } from "../../types/env";
---

<AppLayout title="Channel Installations" appShell={true}>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-sm font-semibold text-blue-700">Channel delivery</p><h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Telegram and WhatsApp</h1><p class="mt-1 max-w-2xl text-sm leading-6 text-slate-600">Connect a channel account to a Chat Service. Credentials are encrypted and never displayed after saving.</p></div><a href="/dashboard/channels" class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Channel overview</a></div>

  <section class="mt-8 rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><div class="grid gap-4 lg:grid-cols-[1fr_1fr_1fr]"><label class="text-sm font-medium text-slate-700">Project<select id="project" class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm"></select></label><label class="text-sm font-medium text-slate-700">Chat Service<select id="service" class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm"></select></label><label class="text-sm font-medium text-slate-700">Channel<select id="channel" class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm"><option value="telegram">Telegram</option><option value="whatsapp">WhatsApp Business</option></select></label></div><form id="install" class="mt-5 grid gap-4 border-t border-slate-100 pt-5 md:grid-cols-2"><label class="text-sm font-medium text-slate-700">External account ID<input id="account" required class="mt-1.5 block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm" placeholder="Telegram bot ID or WhatsApp account ID" /></label><label class="text-sm font-medium text-slate-700">Webhook verification secret<input id="webhook-secret" type="password" required minlength="16" class="mt-1.5 block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm" placeholder="At least 16 characters" /></label><label id="bot-token-field" class="text-sm font-medium text-slate-700">Telegram bot token<input id="bot-token" type="password" class="mt-1.5 block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm" placeholder="Bot token" /></label><label id="app-secret-field" class="hidden text-sm font-medium text-slate-700">WhatsApp app secret<input id="app-secret" type="password" class="mt-1.5 block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm" placeholder="Meta app secret" /></label><label id="access-token-field" class="hidden text-sm font-medium text-slate-700">WhatsApp access token<input id="access-token" type="password" class="mt-1.5 block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm" placeholder="Permanent access token" /></label><label id="phone-id-field" class="hidden text-sm font-medium text-slate-700">WhatsApp phone number ID<input id="phone-id" class="mt-1.5 block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm" placeholder="Phone number ID" /></label><div class="flex items-end"><button class="rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700" type="submit">Install channel</button></div></form><p id="message" class="mt-3 min-h-5 text-sm" role="status"></p></section>

  <section class="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><div class="flex items-center justify-between gap-3"><div><h2 class="font-bold text-slate-950">Installed channels</h2><p class="mt-1 text-sm text-slate-500">Inbound events are deduplicated and mapped to tenant conversations.</p></div><span id="count" class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">0</span></div><div id="installations" class="mt-4 space-y-2"></div></section>

  <script is:inline define:vars={{ apiBaseUrl: API_BASE_URL }}>
    const project = document.querySelector("#project"); const service = document.querySelector("#service"); const channel = document.querySelector("#channel"); const installations = document.querySelector("#installations"); const message = document.querySelector("#message");
    const fields = { telegram: ["bot-token-field"], whatsapp: ["app-secret-field", "access-token-field", "phone-id-field"] };
    function showMessage(text, error = false) { message.textContent = text; message.className = `mt-3 min-h-5 text-sm ${error ? "text-red-600" : "text-emerald-600"}`; }
    async function api(path, options = {}) { const response = await fetch(`${apiBaseUrl}${path}`, { credentials: "include", ...options }); const data = await response.json().catch(() => ({})); if (!response.ok) throw new Error(data?.error?.message || "Request failed."); return data; }
    function toggleFields() { Object.values(fields).flat().forEach((id) => document.querySelector(`#${id}`).classList.add("hidden")); fields[channel.value].forEach((id) => document.querySelector(`#${id}`).classList.remove("hidden")); document.querySelector("#bot-token").required = channel.value === "telegram"; document.querySelector("#app-secret").required = channel.value === "whatsapp"; document.querySelector("#access-token").required = channel.value === "whatsapp"; document.querySelector("#phone-id").required = channel.value === "whatsapp"; }
    async function loadServices() { const data = await api(`/v1/projects/${encodeURIComponent(project.value)}/chat-services`); service.replaceChildren(...(data.chat_services || []).map((item) => { const option = document.createElement("option"); option.value = item.id; option.textContent = `${item.name} (${item.environment})`; return option; })); await loadInstallations(); }
    async function loadInstallations() { if (!service.value) { installations.innerHTML = `<p class="text-sm text-slate-500">Create a Chat Service first.</p>`; return; } const data = await api(`/v1/projects/${encodeURIComponent(project.value)}/chat-services/${encodeURIComponent(service.value)}/channel-installations`); const items = data.installations || []; document.querySelector("#count").textContent = String(items.length); installations.innerHTML = items.length ? items.map((item) => `<div class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-slate-200 p-4"><div><p class="font-semibold text-slate-900">${item.channel === "whatsapp" ? "WhatsApp Business" : "Telegram"}</p><p class="mt-1 text-xs text-slate-500">${item.external_account_id} · ${item.status}</p></div><button type="button" data-delete="${item.id}" class="text-xs font-semibold text-red-600">Remove</button></div>`).join("") : `<p class="text-sm text-slate-500">No channels installed for this service.</p>`; installations.querySelectorAll("[data-delete]").forEach((button) => button.addEventListener("click", async () => { if (!confirm("Remove this channel installation?")) return; await api(`/v1/projects/${encodeURIComponent(project.value)}/chat-services/${encodeURIComponent(service.value)}/channel-installations/${encodeURIComponent(button.dataset.delete)}`, { method: "DELETE" }); await loadInstallations(); })); }
    async function loadProjects() { try { const data = await api("/v1/projects"); project.replaceChildren(...(data.projects || []).map((item) => { const option = document.createElement("option"); option.value = item.id; option.textContent = `${item.name} (${item.environment})`; return option; })); await loadServices(); } catch (error) { location.href = "/login"; } }
    channel.addEventListener("change", toggleFields); project.addEventListener("change", loadServices); service.addEventListener("change", loadInstallations); document.querySelector("#install").addEventListener("submit", async (event) => { event.preventDefault(); const submit = event.currentTarget.querySelector("button"); submit.disabled = true; try { const credentials = channel.value === "telegram" ? { bot_token: document.querySelector("#bot-token").value } : { app_secret: document.querySelector("#app-secret").value, access_token: document.querySelector("#access-token").value, phone_number_id: document.querySelector("#phone-id").value }; await api(`/v1/projects/${encodeURIComponent(project.value)}/chat-services/${encodeURIComponent(service.value)}/channel-installations`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ channel: channel.value, external_account_id: document.querySelector("#account").value, webhook_secret: document.querySelector("#webhook-secret").value, credentials }) }); event.currentTarget.reset(); toggleFields(); showMessage("Channel installed securely."); await loadInstallations(); } catch (error) { showMessage(error.message, true); } finally { submit.disabled = false; } }); toggleFields(); loadProjects();
  </script>
</AppLayout>
