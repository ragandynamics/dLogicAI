---
import AppLayout from "../../layouts/AppLayout.astro";
import { API_BASE_URL } from "../../types/env";

const connectors = [
  ["CRM", "Salesforce", "Customer profiles, leads, opportunities and account activity", "Connected", "10,000", "7,240"],
  ["CRM", "HubSpot", "Contacts, companies, deals and engagement history", "Available", "5,000", "0"],
  ["Support", "Zendesk", "Tickets, customer context and support outcomes", "Connected", "5,000", "3,182"],
  ["ERP", "SAP", "Orders, customer records and operational status", "Available", "2,000", "0"],
  ["Messaging", "WhatsApp Business", "Conversation delivery and customer interaction events", "Connected", "20,000", "12,486"],
];
---

<AppLayout title="Integrations" appShell={true}>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Integration Connectors</h1>
      <p class="mt-1 max-w-3xl text-sm leading-6 text-slate-600">Connect dLogicAI to CRM, support, ERP and messaging systems. Each connector can have an included monthly API-call allowance; additional calls are billed separately.</p>
    </div>
    <a href="/dashboard/billing" class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">View connector billing</a>
  </div>

  <div class="mt-8 grid gap-5 xl:grid-cols-2">
    {connectors.map(([category, name, desc, status, allowance, used]) => {
      const pct = Math.min(100, (Number(used.replaceAll(",", "")) / Number(allowance.replaceAll(",", ""))) * 100);
      return (
        <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <div class="flex items-center gap-2">
                <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-slate-600">{category}</span>
                <span class:list={["rounded-full px-2.5 py-1 text-[10px] font-bold", status === "Connected" ? "bg-emerald-50 text-emerald-700" : "bg-amber-50 text-amber-700"]}>{status}</span>
              </div>
              <h2 class="mt-3 text-lg font-bold text-slate-950">{name}</h2>
              <p class="mt-1 text-sm leading-6 text-slate-600">{desc}</p>
            </div>
            <button class="shrink-0 rounded-lg bg-blue-600 px-3.5 py-2 text-sm font-semibold text-white hover:bg-blue-700">{status === "Connected" ? "Manage" : "Connect"}</button>
          </div>

          <div class="mt-6 rounded-xl bg-slate-50 p-4">
            <div class="flex items-center justify-between gap-4 text-sm">
              <span class="font-medium text-slate-700">Monthly API calls</span>
              <span class="font-semibold text-slate-950">{used} / {allowance}</span>
            </div>
            <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-200">
              <div class="h-full rounded-full bg-blue-600" style={`width:${pct}%`}></div>
            </div>
            <div class="mt-3 flex items-center justify-between gap-4 text-xs text-slate-500">
              <span>{Math.max(0, Number(allowance.replaceAll(",", "")) - Number(used.replaceAll(",", ""))).toLocaleString()} calls remaining</span>
              <span>Overage: billed per additional call</span>
            </div>
          </div>
        </article>
      );
    })}
  </div>

  <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-xs font-bold uppercase tracking-wide text-blue-700">Commerce connectors</p><h2 class="mt-1 text-xl font-bold text-slate-950">Marketplace data for guided conversations</h2><p class="mt-1 max-w-2xl text-sm leading-6 text-slate-600">Install a marketplace connector per project environment. Credentials are encrypted and never shown again.</p></div><label class="text-sm font-medium text-slate-700">Project<select id="commerce-project" class="mt-1 block rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm"></select></label></div>
    <div id="commerce-connectors" class="mt-5 grid gap-4 md:grid-cols-2"></div>
    <p id="commerce-message" class="mt-4 min-h-5 text-sm" role="status"></p>
  </section>

  <section class="mt-5 grid gap-5 lg:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="text-xs font-bold uppercase tracking-wide text-blue-700">1 · Included</div>
      <h2 class="mt-2 font-bold text-slate-950">Bundled connector calls</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600">Your subscription can include a fixed number of connector API calls per month.</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="text-xs font-bold uppercase tracking-wide text-blue-700">2 · Overage</div>
      <h2 class="mt-2 font-bold text-slate-950">Additional calls</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600">Calls beyond the bundled allowance are metered and billed separately using your configured connector rate.</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="text-xs font-bold uppercase tracking-wide text-blue-700">3 · Forecast</div>
      <h2 class="mt-2 font-bold text-slate-950">Cost visibility</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600">The billing estimator can combine subscription bundles, connector overages, retention, archival and other add-ons into a forecast.</p>
      <a href="/dashboard/billing" class="mt-4 inline-block text-sm font-semibold text-blue-600 hover:text-blue-700">Open estimator →</a>
    </div>
  </section>
</AppLayout>

<script is:inline define:vars={{ apiBaseUrl: API_BASE_URL }}>
  const commerceProject = document.querySelector("#commerce-project");
  const commerceConnectors = document.querySelector("#commerce-connectors");
  const commerceMessage = document.querySelector("#commerce-message");
  const catalog = [
    ["amazon", "Amazon SP-API", "Orders, shipments, returns, products, and inventory.", "seller_id, marketplace_id, client_id, client_secret, refresh_token"],
    ["shopee", "Shopee", "Shop orders, products, inventory, and fulfillment.", "partner_id, partner_key, shop_id, access_token"],
    ["lazada", "Lazada", "Orders, products, inventory, and shipment status.", "app_key, app_secret, access_token, seller_id"],
    ["tiktok_shop", "TikTok Shop", "Shop orders, catalog, fulfillment, and seller data.", "app_key, app_secret, access_token, shop_id"],
  ];
  function showCommerceMessage(text, error = false) { commerceMessage.textContent = text; commerceMessage.className = `mt-4 min-h-5 text-sm ${error ? "text-red-600" : "text-emerald-600"}`; }
  async function commerceApi(path, options = {}) { const response = await fetch(`${apiBaseUrl}${path}`, { credentials: "include", ...options }); const data = await response.json().catch(() => ({})); if (!response.ok) throw new Error(data?.error?.message || "Connector request failed."); return data; }
  async function renderCommerce() { if (!commerceProject.value) return; try { const data = await commerceApi(`/v1/projects/${encodeURIComponent(commerceProject.value)}/connectors`); const installed = data.connectors || []; commerceConnectors.innerHTML = catalog.map(([key, name, description, fields]) => { const matches = installed.filter((item) => item.key === key); return `<article class="rounded-xl border border-slate-200 p-4"><div class="flex items-start justify-between gap-3"><div><h3 class="font-bold text-slate-950">${name}</h3><p class="mt-1 text-sm leading-5 text-slate-600">${description}</p></div><span class="rounded-full ${matches.length ? "bg-emerald-50 text-emerald-700" : "bg-slate-100 text-slate-600"} px-2 py-1 text-[11px] font-semibold">${matches.length ? `${matches.length} installed` : "Not installed"}</span></div>${matches.map((item) => `<div class="mt-3 flex items-center justify-between gap-3 rounded-lg bg-slate-50 p-3"><div><p class="text-sm font-semibold text-slate-800">${item.name}</p><p class="text-xs text-slate-500">${item.environment} · ${item.status}${item.last_error_code ? ` · ${item.last_error_code}` : ""}</p></div><button type="button" data-test="${item.id}" class="text-xs font-semibold text-blue-600">Test</button></div>`).join("")}<form data-connector="${key}" class="mt-4 space-y-2"><input name="name" required maxlength="100" placeholder="Installation name" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" /><input name="credentials" type="password" required placeholder="Enter credentials as key=value, comma separated" aria-label="${fields}" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" /><p class="text-[11px] leading-4 text-slate-500">Required fields: ${fields}</p><button class="rounded-lg bg-slate-900 px-3 py-2 text-xs font-semibold text-white hover:bg-slate-700">Install connector</button></form></article>`; }).join(""); commerceConnectors.querySelectorAll("[data-connector]").forEach((form) => form.addEventListener("submit", async (event) => { event.preventDefault(); const data = new FormData(event.currentTarget); const credentials = Object.fromEntries(String(data.get("credentials")).split(",").map((entry) => entry.split("=").map((part) => part.trim())).filter(([key, value]) => key && value)); try { await commerceApi(`/v1/projects/${encodeURIComponent(commerceProject.value)}/connectors`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ connector_key: event.currentTarget.dataset.connector, name: data.get("name"), credentials }) }); showCommerceMessage("Connector installed securely."); await renderCommerce(); } catch (error) { showCommerceMessage(error.message, true); } })); commerceConnectors.querySelectorAll("[data-test]").forEach((button) => button.addEventListener("click", async () => { try { const data = await commerceApi(`/v1/projects/${encodeURIComponent(commerceProject.value)}/connectors/${encodeURIComponent(button.dataset.test)}/test`, { method: "POST" }); showCommerceMessage(data.ok ? "Connector credentials are configured." : data.error_code || "Connector credentials need attention.", !data.ok); await renderCommerce(); } catch (error) { showCommerceMessage(error.message, true); } })); } catch (error) { showCommerceMessage(error.message, true); } }
  async function loadCommerceProjects() { try { const data = await commerceApi("/v1/projects"); const projects = data.projects || []; const requested = new URLSearchParams(window.location.search).get("projectId"); const stored = window.sessionStorage.getItem("dlogicai_active_project"); const active = projects.find((project) => project.id === requested) || projects.find((project) => project.id === stored) || projects[0]; commerceProject.replaceChildren(...projects.map((project) => { const option = document.createElement("option"); option.value = project.id; option.textContent = `${project.name} (${project.environment})`; return option; })); if (active) commerceProject.value = active.id; await renderCommerce(); } catch { commerceMessage.textContent = "Sign in to manage marketplace connectors."; commerceMessage.className = "mt-4 min-h-5 text-sm text-slate-500"; } }
  commerceProject.addEventListener("change", renderCommerce);
  loadCommerceProjects();
</script>
