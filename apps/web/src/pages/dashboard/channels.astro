---
import TenantJourney from "../../components/TenantJourney.astro";
import { API_BASE_URL } from "../../types/env";
import AppLayout from "../../layouts/AppLayout.astro";
const channels = [
  { id: "web", name: "Web Chat", description: "Customize your widget, preview replies, copy the embed code and activate it on your website." },
  { id: "telegram", name: "Telegram", description: "Connect with Telegram to create a bot, then activate customer conversations." },
  { id: "whatsapp", name: "WhatsApp Business", description: "Connect your business account, verify its callback, and activate customer conversations." },
];
---
<AppLayout title="Channels" appShell={true}>
  <h1 class="text-3xl font-bold text-slate-950">Customer channels</h1>
  <p class="mt-3 max-w-3xl text-slate-600">Bring customer conversations into the same Chat Service. Choose a channel to configure an existing connection or create a new one.</p>
  <TenantJourney />
  <div class="mt-8 grid gap-6 md:grid-cols-3">
    {channels.map((channel) => <article class="flex flex-col rounded-xl border bg-white p-6 shadow-sm">
      <h2 class="text-xl font-semibold">{channel.name}</h2>
      <p class="mt-3 grow text-sm leading-6 text-slate-600">{channel.description}</p>
      <a data-channel={channel.id} href={`/dashboard/channel-installations?channel=${channel.id}`} class="mt-6 rounded-lg bg-blue-600 px-4 py-3 text-center font-semibold text-white">Set up {channel.name}</a>
    </article>)}
  </div>
  <p class="mt-6 text-sm text-slate-500">Facebook Messenger, Instagram and TikTok are planned. Telegram and WhatsApp setup requires your provider credentials and webhook configuration.</p>
  <script is:inline>
    const query = new URLSearchParams(location.search);
    document.querySelectorAll("[data-channel]").forEach((link) => {
      const params = new URLSearchParams({ channel: link.dataset.channel });
      for (const key of ["projectId", "serviceId"]) if (query.get(key)) params.set(key, query.get(key));
      link.href = `/dashboard/${link.dataset.channel === "web" ? "webchat" : link.dataset.channel === "telegram" ? "telegram-connect" : "channel-installations"}?${params}`;
    });
  </script>

  <section class="mt-8 rounded-xl border border-slate-200 bg-white p-6">
    <div class="flex items-center justify-between gap-3"><h2 class="text-xl font-semibold">Your connections</h2><button id="refresh-connections" class="rounded-lg border px-3 py-2 text-sm">Refresh</button></div>
    <p class="mt-2 text-sm text-slate-600">Draft → configure and install. Testing → finish the provider callback. Active → send a real message and confirm a reply. Activation alone does not prove delivery.</p>
    <p id="connection-status" role="status" class="mt-4 text-sm text-slate-600">Loading connections…</p>
    <div id="connection-list" class="mt-4 grid gap-4 md:grid-cols-2"></div>
  </section>
  <script is:inline define:vars={{ apiBaseUrl: API_BASE_URL }}>
  (() => {
    const list=document.getElementById("connection-list"), status=document.getElementById("connection-status"), refresh=document.getElementById("refresh-connections");
    const e=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
    async function loadConnections() {
      refresh.disabled=true; status.textContent="Loading connections…";
      try {
        const response=await fetch(apiBaseUrl+"/v1/operations/channels",{credentials:"include"});
        if(!response.ok) throw new Error(response.status===401?"Your session has expired. Sign in again.":"Unable to load connections. Please try Refresh.");
        const data=await response.json(); const rows=data.records||[];
        list.innerHTML=rows.map(r=>{
          const params=new URLSearchParams({projectId:r.project_id,serviceId:r.chat_service_id,channel:r.channel});
          if(r.channel==="web") params.set("widgetId",r.id);
          const href="/dashboard/"+(r.channel==="web"?"webchat":"channel-installations")+"?"+params;
          const next=r.status==="active"?"Test a real reply, then check conversations and usage.":r.status==="inactive"?"Review settings, then reactivate when ready.":"Finish configuration and installation, then activate.";
          return '<article class="rounded-lg border border-slate-200 p-4"><div class="flex justify-between gap-3"><h3 class="font-semibold">'+e(r.name||r.channel)+'</h3><span class="rounded-full bg-slate-100 px-2 py-1 text-xs">'+e(r.status)+'</span></div><p class="mt-2 text-sm text-slate-500">'+e(r.project_name)+' · '+e(r.service_name)+' · '+e(r.channel)+'</p><p class="mt-3 text-sm">'+next+'</p><a class="mt-4 inline-block text-sm font-semibold text-blue-700 underline" href="'+e(href)+'">'+(r.status==="active"?"Manage connection":"Continue setup")+'</a></article>';
        }).join("");
        status.textContent=rows.length?rows.length+" saved connections · Refreshed "+new Date().toLocaleTimeString():"No channels yet. Choose a channel above to create your first connection.";
      } catch(error) { list.replaceChildren();status.textContent=error.message; }
      finally {refresh.disabled=false;}
    }
    refresh.addEventListener("click",loadConnections); loadConnections();
  })();
  </script>

</AppLayout>
