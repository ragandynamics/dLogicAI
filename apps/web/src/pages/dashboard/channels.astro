---
import AppLayout from "../../layouts/AppLayout.astro";
import { API_BASE_URL } from "../../types/env";

const channels = [
  {
    id: "web",
    name: "Web Chat",
    description:
      "Embed dLogicAI conversational experiences directly into your website or web application.",
    status: "Available",
    color: "blue",
    capabilities: [
      "Guided transactions",
      "Free-form messages",
      "Rich responses",
      "Business functions",
      "Conversation intelligence",
    ],
  },
  {
    id: "whatsapp",
    name: "WhatsApp",
    description:
      "Connect a WhatsApp Business account so customers can interact with your dLogicAI services through WhatsApp.",
    status: "Coming soon",
    color: "emerald",
    capabilities: [
      "Customer messaging",
      "Guided transactions",
      "Business functions",
      "Conversation intelligence",
      "Webhook integration",
    ],
  },
  {
    id: "facebook",
    name: "Facebook Messenger",
    description:
      "Connect Facebook Messenger conversations to the same dLogicAI conversation and transaction engine.",
    status: "Coming soon",
    color: "indigo",
    capabilities: [
      "Messenger conversations",
      "Guided transactions",
      "Business functions",
      "Conversation intelligence",
    ],
  },
  {
    id: "instagram",
    name: "Instagram",
    description:
      "Prepare your customer service and sales conversations on Instagram for dLogicAI processing.",
    status: "Coming soon",
    color: "pink",
    capabilities: [
      "Instagram messaging",
      "Guided transactions",
      "Sales conversations",
      "Conversation intelligence",
    ],
  },
  {
    id: "telegram",
    name: "Telegram",
    description:
      "Connect a Telegram bot and route customer conversations through your dLogicAI services.",
    status: "Coming soon",
    color: "sky",
    capabilities: [
      "Telegram bot",
      "Guided transactions",
      "Business functions",
      "Conversation intelligence",
    ],
  },
  {
    id: "tiktok",
    name: "TikTok",
    description:
      "Future channel support for TikTok messaging capabilities subject to available APIs and platform permissions.",
    status: "Planned",
    color: "slate",
    capabilities: [
      "Customer messaging",
      "Business conversations",
      "Guided transactions",
      "Conversation intelligence",
    ],
  },
];
---

<AppLayout
  title="Channels"
  appShell={true}
>
  <!-- Header -->
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <div class="flex items-center gap-2">
        <span class="rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700">
          Customer channels
        </span>

        <span class="text-xs text-slate-400">
          One conversation engine
        </span>
      </div>

      <h1 class="mt-3 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">
        Channels
      </h1>

      <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-600 sm:text-base">
        Connect the channels where your customers already communicate.
        Every channel uses the same dLogicAI conversation engine,
        guided transactions, AI configuration and business intelligence.
      </p>
    </div>

    <button
      id="add-channel"
      class="rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700"
    >
      Add channel
    </button>
  </div>

  <!-- Architecture explanation -->
  <div class="mt-8 rounded-2xl border border-blue-100 bg-blue-50 p-5 sm:p-6">
    <div class="grid gap-5 lg:grid-cols-[1fr_auto_1fr_auto_1fr] lg:items-center">

      <div>
        <div class="text-xs font-bold uppercase tracking-wide text-blue-600">
          Customer
        </div>

        <div class="mt-2 text-sm font-semibold text-slate-950">
          Web · WhatsApp · Facebook · Instagram · Telegram · TikTok
        </div>
      </div>

      <div class="hidden text-blue-400 lg:block">
        →
      </div>

      <div>
        <div class="text-xs font-bold uppercase tracking-wide text-blue-600">
          dLogicAI
        </div>

        <div class="mt-2 text-sm font-semibold text-slate-950">
          Channel adapter → Conversation engine
        </div>
      </div>

      <div class="hidden text-blue-400 lg:block">
        →
      </div>

      <div>
        <div class="text-xs font-bold uppercase tracking-wide text-blue-600">
          Business outcome
        </div>

        <div class="mt-2 text-sm font-semibold text-slate-950">
          Sales · Service · Payment · Billing · Booking
        </div>
      </div>
    </div>
  </div>

  <!-- Channel cards -->
  <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">

    {
      channels.map((channel) => (
        <article class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">

          <div class="flex items-start justify-between gap-4">

            <div>
              <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-slate-100 text-sm font-bold text-slate-700">
                {channel.id === "web" && "WEB"}
                {channel.id === "whatsapp" && "WA"}
                {channel.id === "facebook" && "FB"}
                {channel.id === "instagram" && "IG"}
                {channel.id === "telegram" && "TG"}
                {channel.id === "tiktok" && "TT"}
              </div>
            </div>

            <span
              class:list={[
                "rounded-full px-2.5 py-1 text-xs font-semibold",
                channel.status === "Available" &&
                  "bg-emerald-50 text-emerald-700",
                channel.status === "Coming soon" &&
                  "bg-amber-50 text-amber-700",
                channel.status === "Planned" &&
                  "bg-slate-100 text-slate-600",
              ]}
            >
              {channel.status}
            </span>
          </div>

          <h2 class="mt-5 text-lg font-bold text-slate-950">
            {channel.name}
          </h2>

          <p class="mt-2 min-h-[72px] text-sm leading-6 text-slate-600">
            {channel.description}
          </p>

          <div class="mt-5 border-t border-slate-100 pt-5">
            <div class="text-xs font-bold uppercase tracking-wide text-slate-500">
              Capabilities
            </div>

            <ul class="mt-3 space-y-2">
              {channel.capabilities.map((capability) => (
                <li class="flex items-center gap-2 text-sm text-slate-600">
                  <span class="text-emerald-500">✓</span>
                  {capability}
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-auto pt-6">

            {
              channel.status === "Available" ? (
                <button
                  class="w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700"
                  data-channel={channel.id}
                >
                  Configure Web Chat
                </button>
              ) : (
                <button
                  disabled
                  class="w-full cursor-not-allowed rounded-lg bg-slate-100 px-4 py-2.5 text-sm font-semibold text-slate-400"
                >
                  {channel.status}
                </button>
              )
            }

          </div>
        </article>
      ))
    }

  </div>

  <!-- Important architecture note -->
  <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">

    <h2 class="text-lg font-bold text-slate-950">
      One service across every channel
    </h2>

    <p class="mt-2 max-w-4xl text-sm leading-6 text-slate-600">
      A Chat Service defines the business experience. Channels only determine
      how customers reach that service. This means the same guided transaction,
      AI provider, business functions and conversation intelligence can be
      reused across Web Chat, WhatsApp, Facebook, Instagram, Telegram and
      future channels.
    </p>

    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">

      <div class="rounded-xl bg-slate-50 p-4">
        <div class="text-xs font-bold uppercase tracking-wide text-slate-500">
          AI
        </div>

        <div class="mt-2 text-sm font-semibold text-slate-950">
          Managed AI or tenant-managed AI
        </div>
      </div>

      <div class="rounded-xl bg-slate-50 p-4">
        <div class="text-xs font-bold uppercase tracking-wide text-slate-500">
          Transactions
        </div>

        <div class="mt-2 text-sm font-semibold text-slate-950">
          Guided end-to-end customer journeys
        </div>
      </div>

      <div class="rounded-xl bg-slate-50 p-4">
        <div class="text-xs font-bold uppercase tracking-wide text-slate-500">
          Intelligence
        </div>

        <div class="mt-2 text-sm font-semibold text-slate-950">
          Intent, emotion, sentiment and commercial signals
        </div>
      </div>

      <div class="rounded-xl bg-slate-50 p-4">
        <div class="text-xs font-bold uppercase tracking-wide text-slate-500">
          Business
        </div>

        <div class="mt-2 text-sm font-semibold text-slate-950">
          Sales, service, payments, billing and booking
        </div>
      </div>

    </div>
  </section>

  <!-- Web Chat setup -->
  <div
    id="web-chat-panel"
    class="mt-8 hidden rounded-2xl border border-blue-200 bg-white p-6 shadow-sm sm:p-8"
  >
    <div class="flex items-start justify-between gap-4">
      <div>
        <span class="rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700">
          Web Chat
        </span>

        <h2 class="mt-3 text-xl font-bold text-slate-950">
          Configure your website chat
        </h2>

        <p class="mt-2 text-sm leading-6 text-slate-600">
          This is the configuration surface for the future dLogicAI web
          widget. The generated widget will connect customers to the selected
          Chat Service without exposing tenant API keys in the browser.
        </p>
      </div>

      <button
        id="close-web-chat"
        class="rounded-lg px-3 py-2 text-sm font-medium text-slate-500 hover:bg-slate-100"
      >
        Close
      </button>
    </div>

    <div class="mt-6 grid gap-5 lg:grid-cols-2">

      <div>
        <label
          for="service-name"
          class="text-sm font-medium text-slate-700"
        >
          Chat Service
        </label>

        <select
          id="service-name"
          class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm"
        >
        </select>
      </div>

      <div>
        <label
          for="domain"
          class="text-sm font-medium text-slate-700"
        >
          Allowed website domain
        </label>

        <input
          id="domain"
          class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm"
          placeholder="https://www.example.com"
        />
      </div>

    </div>

    <div class="mt-6 rounded-xl bg-slate-950 p-5 text-sm text-slate-200">
      <div class="mb-3 text-xs font-bold uppercase tracking-wide text-slate-400">
        Future embed code
      </div>

      <code class="block overflow-x-auto whitespace-pre-wrap leading-6">
&lt;script
  src="https://api.dlogicai.com/widget/dlogicai.js"
  data-service-id="YOUR_SERVICE_ID"
&gt;&lt;/script&gt;
      </code>
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      <button
        id="save-web-chat"
        class="rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700"
      >
        Save configuration
      </button>

      <span
        id="web-chat-message"
        class="self-center text-sm text-slate-500"
      ></span>
    </div>
  </div>

  <script is:inline define:vars={{ apiBaseUrl: API_BASE_URL }}>
    const addChannelButton =
      document.querySelector("#add-channel");

    const webChatPanel =
      document.querySelector("#web-chat-panel");

    const closeWebChat =
      document.querySelector("#close-web-chat");

    const webChatMessage =
      document.querySelector("#web-chat-message");

    function openWebChat() {
      webChatPanel?.classList.remove("hidden");

      webChatPanel?.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    }

    function closePanel() {
      webChatPanel?.classList.add("hidden");
    }

    addChannelButton?.addEventListener(
      "click",
      openWebChat
    );

    closeWebChat?.addEventListener(
      "click",
      closePanel
    );

    document
      .querySelectorAll("[data-channel]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          const channel =
            button.getAttribute("data-channel");

          if (channel === "web") {
            openWebChat();
          }
        });
      });

    const query = new URLSearchParams(window.location.search);
    const projectId = query.get("projectId") || "";
    const requestedServiceId = query.get("serviceId") || "";
    const requestedService = query.get("service");
    const serviceSelect = document.querySelector("#service-name");

    async function loadServices() {
      if (!projectId || !serviceSelect) return;
      const response = await fetch(`${apiBaseUrl}/v1/projects/${encodeURIComponent(projectId)}/chat-services`, { credentials: "include" });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        webChatMessage.textContent = data?.error?.message || "Unable to load Chat Services.";
        return;
      }
      serviceSelect.innerHTML = (data.chat_services || []).map((service) => `<option value="${service.id}">${service.name}</option>`).join("");
      const matchingService = requestedServiceId
        ? (data.chat_services || []).find((service) => service.id === requestedServiceId)
        : (data.chat_services || []).find((service) => service.name === requestedService);
      if (matchingService) serviceSelect.value = matchingService.id;
      if (matchingService || requestedService || data.chat_services?.length) openWebChat();
      await loadChannelConfiguration();
    }

    async function loadChannelConfiguration() {
      if (!projectId || !serviceSelect.value) return;
      const response = await fetch(`${apiBaseUrl}/v1/projects/${encodeURIComponent(projectId)}/chat-services/${encodeURIComponent(serviceSelect.value)}/channels`, { credentials: "include" });
      const data = await response.json().catch(() => ({}));
      const webChannel = (data.channels || []).find((channel) => channel.channel === "web");
      document.querySelector("#domain").value = webChannel?.config?.domain || "";
    }

    serviceSelect?.addEventListener("change", loadChannelConfiguration);
    document.querySelector("#save-web-chat")?.addEventListener("click", async () => {
      if (!projectId || !serviceSelect.value) {
        webChatMessage.textContent = "Select a project with a Chat Service before saving.";
        return;
      }
      const response = await fetch(`${apiBaseUrl}/v1/projects/${encodeURIComponent(projectId)}/chat-services/${encodeURIComponent(serviceSelect.value)}/channels/web`, { method: "PUT", credentials: "include", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ domain: document.querySelector("#domain").value.trim() }) });
      const data = await response.json().catch(() => ({}));
      webChatMessage.textContent = response.ok ? "Web Chat configuration saved." : data?.error?.message || "Unable to save Web Chat configuration.";
    });

    loadServices();
  </script>
</AppLayout>