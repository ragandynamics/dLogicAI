---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Projects" appShell={true}>
  <div class="flex flex-col gap-1 sm:flex-row sm:items-end sm:justify-between"><div><h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Projects</h1><p class="mt-1 text-sm text-slate-600">Create isolated API projects for development, staging and production.</p></div></div>
  <div class="mt-8 rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><form id="create" class="grid grid-cols-1 gap-4 md:grid-cols-[1fr_220px_auto] md:items-end"><div><label class="text-sm font-medium text-slate-700">Name</label><input class="mt-1.5 block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" name="name" required placeholder="Customer Service API" /></div><div><label class="text-sm font-medium text-slate-700">Environment</label><select class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" name="environment"><option>development</option><option>staging</option><option>production</option></select></div><button class="rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">Create project</button></form></div>
  <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm"><div class="overflow-x-auto"><table class="min-w-[720px] w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-5 py-3 font-semibold">Name</th><th class="px-5 py-3 font-semibold">Environment</th><th class="px-5 py-3 font-semibold">Status</th><th class="px-5 py-3 font-semibold">ID</th></tr></thead><tbody id="rows" class="divide-y divide-slate-100"></tbody></table></div></div>
  <script>
    import { API_BASE_URL } from "../../types/env";
    const load = async () => { const r = await fetch(`${API_BASE_URL}/v1/projects`); if (!r.ok) { location.href = "/login"; return; } const d = await r.json(); document.querySelector("#rows")!.innerHTML = (d.projects || []).map((p: any) => `<tr class="hover:bg-slate-50"><td class="px-5 py-3 font-medium text-slate-900">${p.name}</td><td class="px-5 py-3"><span class="rounded-full bg-blue-50 px-2 py-1 text-xs font-semibold text-blue-700">${p.environment}</span></td><td class="px-5 py-3 text-slate-600">${p.status}</td><td class="px-5 py-3 font-mono text-xs text-slate-500">${p.id}</td></tr>`).join(""); };
    document.querySelector("#create")?.addEventListener("submit", async (e) => { e.preventDefault(); const form = new FormData(e.currentTarget as HTMLFormElement); const r = await fetch(`${API_BASE_URL}/v1/projects`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ name: form.get("name"), environment: form.get("environment") }) }); const d = await r.json().catch(() => ({})); if (!r.ok) { alert(d.error?.message || "Unable to create project"); return; } (e.currentTarget as HTMLFormElement).reset(); load(); });
    load();
  </script>
</AppLayout>
