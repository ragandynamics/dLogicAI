---
import AppLayout from "../../layouts/AppLayout.astro";
import { API_BASE_URL } from "../../types/env";
---

<AppLayout title="Usage & Intelligence" appShell={true}>
  <div><h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Usage & Intelligence</h1><p class="mt-1 text-sm text-slate-600">Monitor requests, tokens, provider costs and customer intelligence.</p></div>
  <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><div class="text-sm text-slate-500">Requests</div><div id="requests" class="mt-2 text-3xl font-bold text-slate-950">—</div></div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><div class="text-sm text-slate-500">Input tokens</div><div id="input" class="mt-2 text-3xl font-bold text-slate-950">—</div></div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><div class="text-sm text-slate-500">Output tokens</div><div id="output" class="mt-2 text-3xl font-bold text-slate-950">—</div></div>
    <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><div class="text-sm text-slate-500">Customer charges</div><div id="charges" class="mt-2 text-3xl font-bold text-slate-950">—</div></div>
  </div>
</AppLayout>
<script is:inline define:vars={{ apiBaseUrl: API_BASE_URL }}>
  fetch(`${apiBaseUrl}/v1/usage`).then(async r => {
    if (!r.ok) {
      location.href = "/login";
      return;
    }

    const d = await r.json();
    const s = d.summary || {};

    const requests = document.querySelector("#requests");
    const input = document.querySelector("#input");
    const output = document.querySelector("#output");
    const charges = document.querySelector("#charges");

    if (requests) requests.textContent = s.requests ?? 0;
    if (input) input.textContent = s.input_tokens ?? 0;
    if (output) output.textContent = s.output_tokens ?? 0;

    if (charges) {
      charges.textContent =
        ((s.customer_charge_micros ?? 0) / 1000000).toFixed(2);
    }
  });
</script>
