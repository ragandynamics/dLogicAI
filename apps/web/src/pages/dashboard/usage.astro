---
import AppLayout from "../../layouts/AppLayout.astro";
import OperationsReport from "../../components/OperationsReport.astro";
import TenantJourney from "../../components/TenantJourney.astro";
---
<AppLayout title="Usage tracking" appShell={true}>
  <h1 class="text-3xl font-bold text-slate-950">Usage tracking</h1>
  <p class="mt-3 max-w-4xl text-sm leading-6 text-slate-600">Track completed, failed and pending AI requests across projects. Token totals include completed requests only. Requests are counted by creation time; this view does not attribute usage to individual channels. See Billing for your credit balance.</p>
  <TenantJourney />
  <a href="/dashboard/billing" class="mt-4 inline-block text-sm font-semibold text-blue-700 underline">View credits and billing</a>
  <OperationsReport view="usage" />
</AppLayout>
