---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Web Chat Embed" appShell={true}>
  <div>
    <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Web Chat Embed</h1>
    <p class="mt-1 max-w-3xl text-sm leading-6 text-slate-600">Add a dLogicAI chat entry point to a website with the snippet below.</p>
  </div>
  <section class="mt-8 max-w-4xl rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <label class="text-sm font-medium text-slate-700" for="key">Project API key</label>
    <input id="key" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm" placeholder="sk_live_..." />
    <label class="mt-4 block text-sm font-medium text-slate-700" for="origin">API origin</label>
    <input id="origin" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm" value="http://127.0.0.1:8787" />
    <h2 class="mt-6 text-lg font-bold text-slate-950">Installation</h2>
    <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm text-slate-600"><li>Copy the generated snippet.</li><li>Paste it before the closing body tag.</li><li>Replace the API key with a restricted production key.</li><li>Test the widget on staging before publishing.</li></ol>
    <pre id="snippet" class="mt-5 overflow-auto rounded-lg bg-slate-950 p-4 text-xs leading-6 text-slate-100"></pre>
  </section>
  <script is:inline>
    const key = document.querySelector("#key"); const origin = document.querySelector("#origin"); const snippet = document.querySelector("#snippet"); const render = () => { const apiKey = key.value || "YOUR_PROJECT_API_KEY"; snippet.textContent = `<script>window.dlogicaiConfig = { apiKey: "${apiKey}", apiOrigin: "${origin.value}" };<\/script>\n<script async src="${window.location.origin}/embed.js"><\/script>`; }; key.addEventListener("input", render); origin.addEventListener("input", render); render();
  </script>
</AppLayout>
