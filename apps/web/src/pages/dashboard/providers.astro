---
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="AI Providers" appShell={true}>
  <div><h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">AI Providers</h1><p class="mt-1 text-sm text-slate-600">Choose dLogicAI managed AI or configure tenant-owned provider credentials.</p></div>
  <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><div class="flex items-center justify-between gap-4"><h2 class="text-lg font-bold text-slate-950">dLogicAI Managed AI</h2><span class="rounded-full bg-emerald-50 px-2 py-1 text-xs font-semibold text-emerald-700">Managed</span></div><p class="mt-3 text-sm leading-6 text-slate-600">Use the managed provider configured by dLogicAI.</p></div>
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><div class="flex items-center justify-between gap-4"><h2 class="text-lg font-bold text-slate-950">Bring Your Own Key</h2><span class="rounded-full bg-blue-50 px-2 py-1 text-xs font-semibold text-blue-700">BYOK</span></div><p class="mt-3 text-sm leading-6 text-slate-600">Connect OpenAI or Google Gemini for a project.</p></div>
  </div>
</AppLayout>
