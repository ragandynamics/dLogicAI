---
import AppLayout from "../../layouts/AppLayout.astro";
import { API_BASE_URL } from "../../types/env";
---

<AppLayout title="AI Providers" appShell={true}>
  <div><h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">AI Providers</h1><p class="mt-1 text-sm text-slate-600">Use dLogicAI managed AI or configure a tenant-owned LLM key for a project.</p></div>
  <div class="mt-8 grid gap-5 lg:grid-cols-2">
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-bold text-slate-950">dLogicAI Managed AI</h2><p class="mt-3 text-sm leading-6 text-slate-600">Use the default provider provisioning configured by dLogicAI. No tenant key is required.</p></div>
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm"><h2 class="text-lg font-bold text-slate-950">Tenant LLM key</h2><p class="mt-3 text-sm leading-6 text-slate-600">Store an OpenAI or Google Gemini key for services configured to use tenant provisioning.</p></div>
  </div>
  <div class="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
    <form id="provider-form" class="grid gap-4 md:grid-cols-[1fr_1.5fr_auto] md:items-end">
      <label class="text-sm font-medium text-slate-700">Provider<select name="provider" class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm"><option value="openai">OpenAI</option><option value="google">Google Gemini</option></select></label>
      <label class="text-sm font-medium text-slate-700">API key<input name="api_key" type="password" required minlength="10" maxlength="1000" autocomplete="new-password" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm" placeholder="Paste your provider key" /></label>
      <button type="submit" class="rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">Save key</button>
    </form>
    <p id="message" class="mt-3 min-h-5 text-sm" role="status"></p>
  </div>
  <div class="mt-6 rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold text-slate-950">Configured tenant keys</h2><div id="providers" class="mt-4 divide-y divide-slate-100"></div></div>

  <script is:inline define:vars={{ apiBaseUrl: API_BASE_URL }}>
    const providers = document.querySelector("#providers");
    const message = document.querySelector("#message");
    function showMessage(text, error = false) { message.textContent = text; message.className = `mt-3 min-h-5 text-sm ${error ? "text-red-600" : "text-emerald-600"}`; }
    async function loadProviders() {
      const response = await fetch(`${apiBaseUrl}/v1/providers`, { credentials: "include" });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) return showMessage(data?.error?.message || "Unable to load tenant keys.", true);
      providers.innerHTML = (data.providers || []).length ? data.providers.map((item) => `<div class="flex items-center justify-between gap-4 py-3 text-sm"><span class="font-medium text-slate-900">${item.name}</span><span class="text-slate-500">${item.provider} · ${item.status}</span></div>`).join("") : `<p class="text-sm text-slate-500">No tenant keys configured for this project.</p>`;
    }
    async function loadProvidersPage() {
      const response = await fetch(`${apiBaseUrl}/v1/providers`, { credentials: "include" });
      if (!response.ok) return (window.location.href = "/login");
      await loadProviders();
    }
    document.querySelector("#provider-form")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const providerForm = event.currentTarget;
      const form = new FormData(providerForm);
      const response = await fetch(`${apiBaseUrl}/v1/providers`, { method: "POST", credentials: "include", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ provider: form.get("provider"), name: `${form.get("provider")} tenant key`, api_key: form.get("api_key") }) });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) return showMessage(data?.error?.message || "Unable to save tenant key.", true);
      providerForm.reset();
      showMessage("Tenant key saved securely.");
      await loadProviders();
    });
    loadProvidersPage();
  </script>
</AppLayout>
