---
import AppLayout from "../../../layouts/AppLayout.astro";
import { API_BASE_URL } from "../../../types/env";
---

<AppLayout title="Dialog Flows" appShell={true}>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div><p class="text-sm font-semibold text-blue-700">Visual conversation design</p><h1 class="mt-1 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Dialog Flows</h1><p class="mt-1 max-w-2xl text-sm leading-6 text-slate-600">Choose a Chat Service to open its working default flow or create a new flow from a template.</p></div>
    <a href="/dashboard/services" class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50">Manage Chat Services</a>
  </div>
  <section id="create-flow" class="mt-8 rounded-2xl border border-blue-100 bg-blue-50 p-5 shadow-sm">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between"><div><p class="text-xs font-bold uppercase tracking-[0.14em] text-blue-700">New flow</p><h2 class="mt-1 text-lg font-bold text-slate-950">Create a dialog flow</h2><p class="mt-1 text-sm text-slate-600">Choose a project and Chat Service. The flow will be attached to that service.</p></div><span id="create-environment" class="rounded-full bg-white px-3 py-1 text-xs font-semibold capitalize text-blue-700">Loading environment…</span></div>
    <div class="mt-5 grid gap-4 md:grid-cols-[1fr_1fr_auto_auto] md:items-end"><label class="text-sm font-medium text-slate-700">Project<select id="create-project" class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm"></select></label><label class="text-sm font-medium text-slate-700">Chat Service<select id="create-service" class="mt-1.5 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm"></select></label><a id="blank-flow-link" href="#" class="rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-center text-sm font-semibold text-slate-700 hover:bg-white">Blank flow</a><a id="template-flow-link" href="#" class="rounded-lg bg-slate-900 px-4 py-2.5 text-center text-sm font-semibold text-white hover:bg-slate-700">Use template</a></div>
    <p id="create-message" class="mt-3 min-h-5 text-sm text-red-600" role="status"></p>
  </section>
  <div id="projects" class="mt-8 space-y-8"><p class="text-sm text-slate-500">Loading Chat Services…</p></div>
  <script is:inline define:vars={{ apiBaseUrl: API_BASE_URL }}>
    const root = document.querySelector("#projects");
    const createProject = document.querySelector("#create-project");
    const createService = document.querySelector("#create-service");
    const createEnvironment = document.querySelector("#create-environment");
    const createMessage = document.querySelector("#create-message");
    const blankFlowLink = document.querySelector("#blank-flow-link");
    const templateFlowLink = document.querySelector("#template-flow-link");
    const escapeHtml = (value) => String(value ?? "").replace(/[&<>\"']/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", "\"": "&quot;", "'": "&#039;" }[character]));
    async function get(path) { const response = await fetch(`${apiBaseUrl}${path}`, { credentials: "include" }); const data = await response.json().catch(() => ({})); if (!response.ok) throw new Error(data?.error?.message || "Unable to load Chat Services."); return data; }
    async function load() { try { const projectData = await get("/v1/projects"); const allProjects = projectData.projects || []; const storedProjectId = window.sessionStorage.getItem("dlogicai_active_project"); const routeProjectId = new URLSearchParams(window.location.search).get("projectId"); const priority = { development: 0, staging: 1, production: 2 }; const activeProject = allProjects.find((project) => project.id === routeProjectId) || allProjects.find((project) => project.id === storedProjectId) || [...allProjects].sort((a, b) => (priority[a.environment] ?? 99) - (priority[b.environment] ?? 99))[0]; const projects = activeProject ? allProjects.filter((project) => project.environment === activeProject.environment) : []; if (!projects.length) { root.innerHTML = `<div class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500">Create a project before designing a dialog flow.</div>`; return; } const groups = await Promise.all(projects.map(async (project) => { const services = (await get(`/v1/projects/${encodeURIComponent(project.id)}/chat-services`)).chat_services || []; const flows = (await Promise.all(services.map(async (service) => ({ service, flow: (await get(`/v1/projects/${encodeURIComponent(project.id)}/chat-services/${encodeURIComponent(service.id)}/dialog-flow`)).dialog_flow })))).filter((item) => item.flow); return { project, services: flows }; })); root.innerHTML = groups.map(({ project, services }) => `<section><div class="flex items-center justify-between gap-3"><div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">${escapeHtml(project.environment)}</p><h2 class="mt-1 text-lg font-bold text-slate-950">${escapeHtml(project.name)}</h2></div><a href="/dashboard/projects/${encodeURIComponent(project.id)}" class="text-xs font-semibold text-blue-600">Project workspace →</a></div><div class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3">${services.length ? services.map(({ service, flow }) => `<article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><div class="flex items-start justify-between gap-3"><div><h3 class="font-bold text-slate-950">${escapeHtml(service.name)}</h3><p class="mt-1 text-sm text-slate-500">${escapeHtml(service.description || "Guided customer conversation")}</p></div><span class="rounded-full bg-blue-50 px-2 py-1 text-[11px] font-semibold text-blue-700">Flow v${escapeHtml(flow.version)}</span></div><div class="mt-5 flex flex-wrap gap-2"><a href="/dashboard/dialog-flows/${encodeURIComponent(service.id)}?projectId=${encodeURIComponent(project.id)}" class="rounded-lg bg-blue-600 px-3 py-2 text-xs font-semibold text-white hover:bg-blue-700">Open designer</a><a href="/dashboard/dialog-flows/${encodeURIComponent(service.id)}?projectId=${encodeURIComponent(project.id)}&new=1" class="rounded-lg border border-slate-300 px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50">New template flow</a></div></article>`).join("") : `<p class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-sm text-slate-500 md:col-span-2 xl:col-span-3">No dialog flows in this environment.</p>`}</div></section>`).join(""); } catch (error) { root.innerHTML = `<p class="text-sm text-red-600">${escapeHtml(error.message)}</p>`; } }
    async function loadFlowCreation() {
      try {
        const projectData = await get("/v1/projects");
        const allProjects = projectData.projects || [];
        const storedProjectId = window.sessionStorage.getItem("dlogicai_active_project");
        const routeProjectId = new URLSearchParams(window.location.search).get("projectId");
        const priority = { development: 0, staging: 1, production: 2 };
        const activeProject = allProjects.find((project) => project.id === routeProjectId) || allProjects.find((project) => project.id === storedProjectId) || [...allProjects].sort((a, b) => (priority[a.environment] ?? 99) - (priority[b.environment] ?? 99))[0];
        const projects = activeProject ? allProjects.filter((project) => project.environment === activeProject.environment) : [];
        createProject.replaceChildren(...projects.map((project) => { const option = document.createElement("option"); option.value = project.id; option.textContent = project.name; return option; }));
        if (activeProject) createProject.value = activeProject.id;
        async function updateServices() {
          const project = projects.find((item) => item.id === createProject.value);
          if (!project) return;
          createEnvironment.textContent = project.environment;
          const data = await get(`/v1/projects/${encodeURIComponent(project.id)}/chat-services`);
          createService.replaceChildren(...(data.chat_services || []).map((service) => { const option = document.createElement("option"); option.value = service.id; option.textContent = service.name; return option; }));
          const updateLinks = () => { const suffix = `?projectId=${encodeURIComponent(project.id)}&new=1`; const serviceId = createService.value; blankFlowLink.href = serviceId ? `/dashboard/dialog-flows/${encodeURIComponent(serviceId)}${suffix}` : "#"; templateFlowLink.href = blankFlowLink.href; createMessage.textContent = serviceId ? "" : "Create a Chat Service before adding a dialog flow."; };
          createService.onchange = updateLinks;
          updateLinks();
        }
        createProject.onchange = updateServices;
        await updateServices();
      } catch (error) {
        createMessage.textContent = error.message;
      }
    }

    load();
    loadFlowCreation();
  </script>
</AppLayout>
