---
import AppLayout from "../../../layouts/AppLayout.astro";
import DialogFlowDesigner from "../../../components/DialogFlowDesigner";
import { API_BASE_URL } from "../../../types/env";

const { serviceId } = Astro.params;
const projectId = new URL(Astro.request.url).searchParams.get("projectId") || "";
const blankDraft = new URL(Astro.request.url).searchParams.get("new") === "1";
---

<AppLayout title="Dialog Flow Designer" appShell={true}>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <a href={`/dashboard/chat-services/${encodeURIComponent(serviceId || "")}?projectId=${encodeURIComponent(projectId)}`} class="text-sm font-medium text-blue-600 hover:text-blue-700">← Chat Service</a>
      <h1 class="mt-3 text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Dialog Flow Designer</h1>
      <p class="mt-1 max-w-3xl text-sm leading-6 text-slate-600">Visually configure guided conversation states, transitions, and expected business outcomes.</p>
    </div>
    <a href="/dashboard/services" title="Return to Chat Services" aria-label="Return to Chat Services" class="inline-flex items-center gap-2 rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50"><span aria-hidden="true">←</span> Chat Services</a>
  </div>

  <div class="mt-6 flex flex-wrap items-center justify-between gap-3 border-y border-slate-200 bg-white px-1 py-4">
    <div><p class="text-xs font-bold uppercase tracking-wide text-slate-400">Flow workspace</p><p class="mt-1 text-sm text-slate-600">Start from a blank draft or choose a template, then save a published version when the path is ready.</p></div>
    <a href={`/dashboard/dialog-flows/${encodeURIComponent(serviceId || "")}?projectId=${encodeURIComponent(projectId)}&new=1`} class="rounded-lg border border-blue-200 bg-blue-50 px-4 py-2.5 text-sm font-semibold text-blue-700 hover:bg-blue-100">New blank draft</a>
  </div>

  <div class="mt-6 border-y border-slate-200 py-5">
  <DialogFlowDesigner
    client:only="react"
    apiBaseUrl={API_BASE_URL}
    projectId={projectId}
    serviceId={serviceId || ""}
    blankDraft={blankDraft}
  />
  </div>
</AppLayout>
