---
import { API_BASE_URL } from "../../types/env";
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout title="Team" appShell={true}>
  <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold tracking-tight text-slate-950 sm:text-3xl">Team</h1>
      <p class="mt-1 text-sm text-slate-600">Manage corporate workspace members and roles.</p>
    </div>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_340px]">
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-200 px-5 py-4">
        <h2 class="font-bold text-slate-950">Members</h2>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-5 py-3">Name</th>
              <th class="px-5 py-3">Email</th>
              <th class="px-5 py-3">Role</th>
            </tr>
          </thead>
          <tbody id="members" class="divide-y divide-slate-100"></tbody>
        </table>
      </div>
    </div>

    <aside id="invite-panel" class="hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div id="invite-form" class="hidden">
        <h2 class="font-bold text-slate-950">Invite member</h2>
        <p class="mt-1 text-sm text-slate-500">Invite a teammate to your workspace.</p>

        <label class="mt-5 block text-sm font-medium text-slate-700">Email</label>
        <input id="email" type="email" required class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm" />

        <label class="mt-4 block text-sm font-medium text-slate-700">Role</label>
        <select id="role" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm">
          <option value="member">Member</option>
          <option value="admin">Admin</option>
        </select>

        <button class="mt-5 w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">
          Send invitation
        </button>

        <p id="message" class="mt-3 min-h-5 text-sm"></p>
      </div>

      <div id="invite-disabled" class="hidden rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
        <p class="font-semibold">Workspace access is enabled for members.</p>
        <p class="mt-2 text-amber-800">Only owners and admins can invite new tenant members.</p>
      </div>
    </aside>
  </div>

  <script is:inline define:vars={{ apiBaseUrl: API_BASE_URL }}>
    const invitePanel = document.querySelector("#invite-panel");
    const inviteForm = document.querySelector("#invite-form");
    const inviteDisabled = document.querySelector("#invite-disabled");

    async function getCurrentUserRole(members) {
      try {
        const meResponse = await fetch(`${apiBaseUrl}/v1/me`, { credentials: "include" });
        if (!meResponse.ok) return "member";

        const me = await meResponse.json().catch(() => ({}));
        const currentUserEmail = typeof me?.user?.email === "string" ? me.user.email.toLowerCase() : "";

        return members.find((member) => (member.email || "").toLowerCase() === currentUserEmail)?.role || "member";
      } catch {
        return "member";
      }
    }

    async function loadMembers() {
      const response = await fetch(`${apiBaseUrl}/v1/organization/members`, { credentials: "include" });
      if (response.status === 401) {
        location.href = "/login";
        return;
      }

      const data = await response.json();
      const members = data.members || [];
      const currentRole = await getCurrentUserRole(members);

      const canInvite = currentRole === "owner" || currentRole === "admin";
      invitePanel.classList.toggle("hidden", false);

      if (canInvite) {
        inviteForm.classList.remove("hidden");
        inviteDisabled.classList.add("hidden");
      } else {
        inviteForm.classList.add("hidden");
        inviteDisabled.classList.remove("hidden");
      }

      document.querySelector("#members").innerHTML =
        members.map(m => `
          <tr>
            <td class="px-5 py-3 font-medium text-slate-900">${m.name || "—"}</td>
            <td class="px-5 py-3 text-slate-600">${m.email || "—"}</td>
            <td class="px-5 py-3"><span class="rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-700">${m.role || "—"}</span></td>
          </tr>
        `).join("");
    }

    document.querySelector("#invite-form")?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const response = await fetch(`${apiBaseUrl}/v1/organization/invitations`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          email: document.querySelector("#email").value,
          role: document.querySelector("#role").value,
        }),
      });

      const data = await response.json().catch(() => ({}));
      const message = document.querySelector("#message");

      message.textContent = response.ok
        ? "Invitation created."
        : data?.error?.message || "Unable to create invitation.";

      message.className = `mt-3 min-h-5 text-sm ${response.ok ? "text-emerald-600" : "text-red-600"}`;

      if (response.ok) {
        document.querySelector("#email").value = "";
      }
    });

    loadMembers();
  </script>
</AppLayout>
