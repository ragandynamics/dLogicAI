---
import TenantJourney from "../../components/TenantJourney.astro";
import AppLayout from "../../layouts/AppLayout.astro";
---
<AppLayout title="Connect Telegram" appShell={true}>
  <h1 class="text-3xl font-bold">Connect Telegram</h1>
  <TenantJourney /><p class="mt-2 text-slate-600">Create a Telegram bot connected to your Chat Service, without copying its token.</p>
  <section class="mt-6 rounded-xl border border-slate-200 bg-white p-6"><div class="grid gap-4 md:grid-cols-2"><label>Project<select id="project" disabled class="mt-2 block w-full rounded-lg border border-slate-300 bg-white p-3"></select></label><label>Chat Service<select id="service" disabled class="mt-2 block w-full rounded-lg border border-slate-300 bg-white p-3"></select></label></div><p id="notice" role="status" aria-live="polite" class="mt-4 text-sm text-slate-700">Loading your workspace…</p><a href="/dashboard/services" class="mt-2 inline-block text-sm text-blue-700 underline">Manage Chat Services</a></section>
  <section class="mt-6 rounded-xl border border-slate-200 bg-white p-6"><h2 class="text-lg font-semibold">1. Link your Telegram identity</h2><p class="mt-2 text-sm text-slate-600">Open Telegram and press Start. Return here to check the connection, then confirm the account displayed below. This connection expires after 15 minutes.</p><button id="start" disabled class="mt-4 rounded bg-blue-600 px-4 py-3 text-white">Connect with Telegram</button><a id="open" hidden target="_blank" rel="noopener noreferrer" class="ml-3 text-blue-700 underline">Open Telegram</a><button id="refresh" hidden class="ml-3 rounded-lg border border-slate-300 bg-white px-4 py-3">Check connection</button><p id="identity" class="mt-4 font-semibold"></p><button id="confirm" hidden class="mt-3 rounded bg-blue-600 px-4 py-3 text-white">Confirm this is my Telegram account</button></section>
  <section class="mt-6 rounded-xl border border-slate-200 bg-white p-6"><h2 class="text-lg font-semibold">2. Create your bot in Telegram</h2><p class="mt-2 text-sm text-slate-600">After confirming your identity, open the bot creation prompt. Finish creating the bot in Telegram, then return and check the connection. Its credentials are stored securely and its webhook is configured automatically.</p><a id="create" hidden target="_blank" rel="noopener noreferrer" class="mt-4 inline-block rounded bg-blue-600 px-4 py-3 text-white">Create bot in Telegram</a></section>
  <section class="mt-6 rounded-xl border border-slate-200 bg-white p-6"><h2 class="text-lg font-semibold">3. Activate and test</h2><p class="mt-2 text-sm text-slate-600">The bot starts in testing. Activate it to receive messages, then send a message to your bot in Telegram and confirm a reply. AI replies use workspace credits.</p><button id="activate" hidden class="mt-4 rounded bg-emerald-700 px-4 py-3 text-white">Activate Telegram</button><a id="manage" hidden class="ml-3 text-blue-700 underline">Manage connection</a></section>
  <p class="mt-6 text-sm text-slate-600">Already have a bot? <a id="manual" href="/dashboard/channel-installations?channel=telegram" class="text-blue-700 underline">Connect with a bot token</a>.</p>
  <script is:inline>
    const $ = (id) => document.getElementById(id); const query = new URLSearchParams(location.search);
    let pending = null, installation = null, available = false, busy = false;
    const scope = () => `/api/v1/projects/${encodeURIComponent($('project').value)}/chat-services/${encodeURIComponent($('service').value)}`;
    const base = () => `${scope()}/telegram-connect`;
    const notice = (text) => $('notice').textContent = text;
    async function api(path, options = {}) { const response = await fetch(path, { credentials: 'include', ...options }); const data = await response.json().catch(() => ({})); if (!response.ok) throw new Error(data.error?.message || 'Connection failed. Please retry.'); return data; }
    function controls() { $('project').disabled = busy || !$('project').options.length; $('service').disabled = busy || !$('service').options.length; $('start').disabled = busy || !available || !$('service').value; for (const id of ['refresh','confirm','activate']) $(id).disabled = busy; }
    function reset() { pending = null; installation = null; available = false; $('identity').textContent = ''; for (const id of ['open','refresh','confirm','create','activate','manage']) $(id).hidden = true; }
    function options(select, items, chosen) { select.replaceChildren(...items.map((item) => new Option(item.name, item.id))); if (items.some((item) => item.id === chosen)) select.value = chosen; }
    async function ready() { reset(); const params = new URLSearchParams({ projectId: $('project').value, serviceId: $('service').value, channel: 'telegram' }); $('manual').href = $('manage').href = `/dashboard/channel-installations?${params}`; if (!$('service').value) { notice('Create a Chat Service to continue.'); return; } const data = await api(base()); available = data.available; notice(available ? 'Select Connect with Telegram to begin.' : 'Telegram Connect needs platform manager-bot setup. You can connect an existing bot with its token below.'); }
    async function services(chosen) { reset(); $('service').replaceChildren(); if (!$('project').value) { notice('Create a project and Chat Service to continue.'); return; } const data = await api(`/api/v1/projects/${encodeURIComponent($('project').value)}/chat-services`); options($('service'), data.chat_services || [], chosen); await ready(); }
    async function task(fn) { if (busy) return; busy = true; controls(); try { await fn(); } catch (error) { notice(error.message); } finally { busy = false; controls(); } }
    async function refresh() { if (!pending) return; const data = await api(`${base()}/${encodeURIComponent(pending)}`); $('confirm').hidden = data.status !== 'linked'; $('create').hidden = data.status !== 'ready'; if (data.create_url) $('create').href = data.create_url; $('identity').textContent = data.telegram_user_id ? `Telegram account: ${data.telegram_name} (ID ${data.telegram_user_id})` : ''; installation = data.installation_id; $('activate').hidden = data.status !== 'completed'; $('manage').hidden = data.status !== 'completed'; const messages = { pending: 'Press Start in Telegram, then check the connection.', linked: 'Confirm the Telegram account above before creating your bot.', ready: 'Open Create bot in Telegram, finish the prompt, then check the connection.', processing: 'Your bot is being connected. Check again shortly.', completed: 'Bot connected and webhook registered. Activate it, then test a reply.', expired: 'This connection expired. Start a new connection.', cancelled: 'This connection was cancelled. Start again.' }; notice(messages[data.status] || 'Check the connection again.'); }
    $('project').onchange = () => task(() => services()); $('service').onchange = () => task(ready);
    $('start').onclick = () => task(async () => { reset(); available = true; const data = await api(base(), { method: 'POST' }); pending = data.id; $('open').href = data.url; $('open').hidden = false; $('refresh').hidden = false; notice('Open Telegram using the link, press Start, then return and check the connection.'); });
    $('refresh').onclick = () => task(refresh);
    $('confirm').onclick = () => task(async () => { await api(`${base()}/${encodeURIComponent(pending)}/confirm`, { method: 'POST' }); await refresh(); });
    $('activate').onclick = () => task(async () => { if (!installation) return; await api(`${scope()}/channel-installations/${encodeURIComponent(installation)}/activate`, { method: 'POST' }); $('activate').hidden = true; notice('Telegram activated. Send your bot a message and confirm it replies.'); });
    task(async () => { const data = await api('/api/v1/projects'); options($('project'), data.projects || [], query.get('projectId')); await services(query.get('serviceId')); });
  </script>
</AppLayout>
