---
import { API_BASE_URL } from "../types/env";
import AppLayout from "../layouts/AppLayout.astro";
import { companyName, siteTagline } from "../lib/site";
---

<AppLayout title="Forgot password">
  <div class="flex min-h-screen items-center justify-center bg-slate-50 px-4 py-12">
    <div class="w-full max-w-md rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <a href="/" class="inline-flex items-center gap-3"><img src="/favicon.ico" alt="{companyName} logo" class="h-8 w-8 rounded-md object-cover" /><div><div class="text-2xl font-extrabold tracking-tight text-slate-950">{companyName}</div><div class="mt-1 text-xs leading-4 text-slate-500">{siteTagline}</div></div></a>
      <h1 class="mt-8 text-2xl font-bold text-slate-950">Reset your password</h1>
      <p class="mt-1 text-sm text-slate-500">Enter your account email and we will send a reset link if it exists.</p>
      <form id="forgot-password" class="mt-6 space-y-4">
        <input name="email" type="email" required autocomplete="email" placeholder="you@company.com" class="block w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm" />
        <button class="w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700">Send reset link</button>
        <p id="message" class="min-h-5 text-sm" role="status"></p>
      </form>
      <a href="/login" class="mt-6 block text-center text-sm font-semibold text-blue-600">Back to sign in</a>
    </div>
  </div>
  <script is:inline define:vars={{ apiBaseUrl: API_BASE_URL }}>
    document.querySelector("#forgot-password")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const form = new FormData(event.currentTarget);
      const message = document.querySelector("#message");
      const response = await fetch(`${apiBaseUrl}/v1/auth/password/forgot`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: form.get("email") }),
      });
      message.textContent = response.ok ? "If the account exists, a reset link has been sent." : "Unable to process the request.";
      message.className = `min-h-5 text-sm ${response.ok ? "text-emerald-600" : "text-red-600"}`;
    });
  </script>
</AppLayout>
