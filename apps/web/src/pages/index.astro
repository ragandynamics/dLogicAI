---
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout title="Welcome">
  <div class="min-h-screen bg-gradient-to-b from-slate-50 via-white to-white">
    <header class="border-b border-slate-200/80 bg-white/80 backdrop-blur">
      <div class="mx-auto flex w-full max-w-7xl items-center justify-between gap-6 px-4 py-4 sm:px-6 lg:px-8">
        <a href="/" class="min-w-0">
          <div class="text-xl font-extrabold tracking-tight text-slate-950">dLogicAI</div>
          <div class="mt-0.5 text-[10px] font-medium leading-4 text-slate-500 sm:text-[11px]">
            AI Powered Customer Conversations
          </div>
        </a>
        <div class="flex items-center gap-2">
          <a href="/login" class="rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">Sign in</a>
          <a href="/register" class="rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700">Create account</a>
        </div>
      </div>
    </header>

    <section class="mx-auto flex w-full max-w-6xl flex-col items-center px-4 pb-16 pt-20 text-center sm:px-6 lg:pb-24 lg:pt-28">
      <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-blue-700">Conversational business intelligence</span>
      <h1 class="mt-6 max-w-4xl text-4xl font-extrabold tracking-tight text-slate-950 sm:text-5xl lg:text-7xl">AI Powered Customer Conversations</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-600 sm:text-xl">dLogicAI helps businesses guide customers through sales, service, payments, billing, booking and appointments while extracting actionable conversation intelligence.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/dashboard" class="rounded-lg bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-blue-700">Open dashboard</a>
        <a href="/pricing" class="rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50">View pricing</a><a href="/login" class="rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50">Sign in</a>
      </div>
    </section>

    <section class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-5 px-4 pb-20 sm:px-6 md:grid-cols-2 lg:grid-cols-4 lg:px-8">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><div class="text-sm font-semibold text-blue-700">01</div><h2 class="mt-3 text-lg font-bold text-slate-950">Guided transactions</h2><p class="mt-2 text-sm leading-6 text-slate-600">Turn customer questions into guided end-to-end business journeys while still allowing free-form messages.</p></div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><div class="text-sm font-semibold text-blue-700">02</div><h2 class="mt-3 text-lg font-bold text-slate-950">Business functions</h2><p class="mt-2 text-sm leading-6 text-slate-600">Support sales, customer service, payments, billing, booking and appointment workflows.</p></div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><div class="text-sm font-semibold text-blue-700">03</div><h2 class="mt-3 text-lg font-bold text-slate-950">Conversation intelligence</h2><p class="mt-2 text-sm leading-6 text-slate-600">Capture intent, emotion, urgency, outcomes and commercial opportunity signals from conversations.</p></div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"><div class="text-sm font-semibold text-blue-700">04</div><h2 class="mt-3 text-lg font-bold text-slate-950">AI choice</h2><p class="mt-2 text-sm leading-6 text-slate-600">Let each tenant use dLogicAI managed AI or configure tenant-owned provider credentials.</p></div>
    </section>
  </div>
</AppLayout>
