---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Playground — dLogicAI">
  <div class="shell">
    <aside class="side"><div class="brand">dLogicAI</div><nav class="nav"><a href="/">Overview</a><a href="/projects">Projects</a><a href="/playground">Playground</a><a href="/usage">Usage</a></nav></aside>
    <main>
      <h1>Playground</h1>
      <div class="card">
        <label>API key<input id="apiKey" type="password" placeholder="sk_live_..." /></label>
        <label>Provider<select id="provider"><option value="">Auto</option><option value="openai">OpenAI</option><option value="google">Gemini</option></select></label>
        <label>Response language<input id="language" placeholder="auto or ta-IN, en-US, etc." value="auto" /></label>
        <label>Message<textarea id="message" rows="6" placeholder="Ask something…"></textarea></label>
        <button id="send">Send</button>
        <pre id="out" style="white-space:pre-wrap;margin-top:20px"></pre>
      </div>
    </main>
  </div>
  <script>
    const API=import.meta.env.PUBLIC_API_URL||"http://localhost:8787";
    send.onclick=async()=>{out.textContent="Thinking…";const r=await fetch(API+"/v1/responses",{method:"POST",headers:{"Content-Type":"application/json","Authorization":`Bearer ${apiKey.value}`},body:JSON.stringify({model:"auto",provider:provider.value||undefined,input:message.value,response_language:language.value||"auto",stream:false})});const d=await r.json();out.textContent=r.ok?d.output_text:(d.error?.message||"Request failed")};
  </script>
</Layout>
