---
export const prerender=false;
Astro.response.headers.set('Cache-Control','no-store');
Astro.response.headers.set('Referrer-Policy','no-referrer');
Astro.response.headers.set('X-Content-Type-Options','nosniff');
Astro.response.headers.set('Content-Security-Policy',"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'");
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="referrer" content="no-referrer"/><title>Secure form</title><script src="/form-runtime.js" defer></script><style is:global>
body{margin:0;background:#f3f6fa;color:#16243a;font:16px/1.6 system-ui}main{max-width:680px;margin:40px auto;padding:32px;background:white;border:1px solid #dce4ed;border-radius:16px}h1{line-height:1.2}label{display:block;font-weight:600;margin-top:20px}input,textarea,select,button{font:inherit;box-sizing:border-box}input:not([type=checkbox]),textarea,select{display:block;width:100%;padding:11px;border:1px solid #9eafc1;border-radius:8px;margin-top:5px}input[type=checkbox]{width:22px;height:22px}button{padding:10px 20px;border:0;border-radius:8px;background:#205acb;color:white;cursor:pointer;margin:20px 12px 0 0}button:disabled{opacity:.5;cursor:wait}button.secondary{background:#e8edf5;color:#183054}.help{font-size:14px;color:#53677b}.error{color:#b42318;font-size:14px}.test{padding:12px;background:#fff0ce;border-radius:8px}dt{font-weight:600;margin-top:18px}dd{margin:4px 0;white-space:pre-wrap;overflow-wrap:anywhere}:focus-visible{outline:3px solid #74a8ff;outline-offset:3px}[hidden]{display:none!important}@media(max-width:720px){main{margin:12px;padding:22px}}
</style></head><body><main id="form-app" data-form-id={Astro.params.formId}><p class="help">Secure information collection</p><h1 id="title">Loading form…</h1><p id="description"></p><p id="test" class="test" hidden>Test submission — no business action will be created.</p><p id="privacy" class="help"></p><p id="status" role="status" aria-live="polite"></p><div id="content"></div></main></body></html>
