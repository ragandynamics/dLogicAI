---
import { API_BASE_URL } from "../types/env";
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout title="Accept invitation">
  <main class="flex min-h-screen items-center justify-center bg-slate-50 px-4 py-12">
    <section class="w-full max-w-lg rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
      <p class="text-sm font-semibold text-blue-700">Workspace invitation</p>
      <h1 class="mt-2 text-2xl font-bold text-slate-950">Join your dLogicFlow workspace</h1>
      <p id="status" class="mt-3 text-sm leading-6 text-slate-600">Checking your invitation…</p>
      <button id="switch-account" type="button" class="mt-6 hidden rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white">Switch account</button>
      <div id="auth-actions" class="mt-6 hidden gap-3">
        <a id="sign-in" class="rounded-lg bg-blue-600 px-4 py-2.5 text-center text-sm font-semibold text-white" href="/login">Sign in</a>
        <a id="register" class="rounded-lg border border-slate-300 px-4 py-2.5 text-center text-sm font-semibold text-slate-700" href="/register">Create account</a>
      </div>
      <a id="continue" class="mt-6 hidden rounded-lg bg-blue-600 px-4 py-2.5 text-center text-sm font-semibold text-white" href="/dashboard">Open workspace</a>
    </section>
  </main>

  <script is:inline define:vars={{ apiBaseUrl: API_BASE_URL }}>
    const status = document.querySelector("#status");
    const token = new URLSearchParams(window.location.search).get("token") || "";
    const next = `/accept-invite?token=${encodeURIComponent(token)}`;
    const switchAccount = document.querySelector("#switch-account");
    switchAccount.addEventListener("click", async () => {
      switchAccount.disabled = true;
      try {
        const response = await fetch(`${apiBaseUrl}/v1/auth/logout`, { method: "POST", credentials: "include" });
        if (!response.ok) throw new Error("Logout failed");
        window.location.href = `/login?next=${encodeURIComponent(next)}`;
      } catch {
        status.textContent = "Unable to switch accounts. Please try again.";
        switchAccount.disabled = false;
      }
    });

    async function acceptInvitation() {
      if (!token) {
        status.textContent = "This invitation link is incomplete.";
        status.className = "mt-3 text-sm text-red-600";
        return;
      }

      const me = await fetch(`${apiBaseUrl}/v1/me`, { credentials: "include" });
      if (me.status === 401) {
        document.querySelector("#sign-in").href = `/login?next=${encodeURIComponent(next)}`;
        document.querySelector("#register").href = `/register?next=${encodeURIComponent(next)}`;
        document.querySelector("#auth-actions").classList.remove("hidden");
        document.querySelector("#auth-actions").classList.add("flex");
        status.textContent = "Sign in or create an account with the invited email address to continue.";
        return;
      }

      const response = await fetch(`${apiBaseUrl}/v1/organization/invitations/accept`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ token }),
      });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) {
        const code = data?.error?.code;
        const messages = {
          INVITATION_ACCOUNT_MISMATCH: "You’re signed in with a different account. Sign in with the email address that received this invitation to continue.",
          INVITATION_ALREADY_ACCEPTED: "This invitation has already been accepted. Open your workspace to continue.",
          EXPIRED_INVITATION: "This invitation has expired. Ask your workspace administrator for a new invitation.",
          INVALID_INVITATION: "This invitation link is invalid or no longer available. Ask your workspace administrator for a new invitation.",
          ALREADY_MEMBER: "You’re already a member of this workspace.",
        };
        status.textContent = messages[code] || "This invitation cannot be accepted. Please try again.";
        if (code === "INVITATION_ACCOUNT_MISMATCH") switchAccount.classList.remove("hidden");
        if (code === "INVITATION_ALREADY_ACCEPTED" || code === "ALREADY_MEMBER") {
          document.querySelector("#continue").classList.remove("hidden");
        }
        status.className = "mt-3 text-sm text-red-600";
        return;
      }

      const switched = await fetch(`${apiBaseUrl}/v1/auth/tenant`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ tenant_id: data.tenantId }),
      });
      status.textContent = switched.ok ? "Invitation accepted. Your new workspace is ready." : "Invitation accepted. Sign in again to open the workspace.";
      status.className = "mt-3 text-sm text-emerald-700";
      document.querySelector("#continue").classList.remove("hidden");
      document.querySelector("#continue").classList.add("block");
    }

    acceptInvitation().catch(() => {
      status.textContent = "Unable to check the invitation. Please check your connection and reload this page.";
    });
  </script>
</AppLayout>
